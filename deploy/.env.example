# ===== Copia este archivo como .env y rellénalo. NUNCA lo subas a git. =====

# Dominio que apunta a tu servidor (registro DNS tipo A)
KROKO_DOMAIN=kroko.tudominio.com

# Solo para docker-compose.vps.yml (VPS con los puertos 80/443 ya ocupados): puerto interno libre
KROKO_PORT=8090

# Token compartido con la App (Ajustes → Cerebro → Token). Genera uno largo y aleatorio, p. ej.:
#   openssl rand -hex 32
Agent__Token=

# Dirección pública (para que Notion y Google devuelvan los permisos al servidor)
Mcp__PublicBaseUrl=https://kroko.tudominio.com

# ----- Claves y cuentas -----
# Lo más fácil: déjalas comentadas y ponlas desde la App (clic derecho en Kroko → Configurar Kroko).
# Se guardan en el volumen /data. Si las descomentas aquí, MANDAN sobre lo que pongas en el asistente
# (una línea vacía como "Telegram__BotToken=" también manda: por eso van comentadas).
#Llm__Gemini__ApiKey=
#Llm__DeepSeek__ApiKey=
#Web__TavilyApiKey=
#Email__Address=
#Email__AppPassword=
#Telegram__BotToken=
