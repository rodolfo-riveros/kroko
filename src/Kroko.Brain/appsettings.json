{
  "Urls": "http://localhost:5080",
  "AllowedHosts": "*",

  "Llm": {
    "Order": [ "gemini", "deepseek" ],
    "MaxOutputTokens": 1024,
    "TimeoutSeconds": 60,
    "Gemini": {
      "Model": "gemini-3.6-flash",
      "BaseUrl": "https://generativelanguage.googleapis.com",
      "ThinkingLevel": "LOW"
    },
    "DeepSeek": {
      "Model": "deepseek-flash",
      "BaseUrl": "https://api.deepseek.com",
      "Thinking": false
    }
  },

  "Agent": {
    "MaxSteps": 15,
    "HistoryMaxMessages": 40,
    "SystemPromptPath": "prompts/system.md",
    "Token": ""
  },

  "Voice": {
    "TtsEnabled": true,
    "TtsModel": "gemini-3.8-flash-tts",
    "Voice": "Puck",
    "Style": "Habla en español con acento {acento} suave, cálido, alegre y natural, a ritmo ágil.",
    "SttModel": "",
    "MaxTtsChars": 1200
  },

  "Productivity": {
    "DailySummaryHour": 8,
    "SpeakNotifications": true
  },

  "Email": {
    "Address": "",
    "DisplayName": "",
    "ImapHost": "imap.gmail.com",
    "ImapPort": 993,
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 465
  },

  "Mcp": {
    "Enabled": true,
    "Servers": {
      "navegador": {
        "Enabled": true,
        "Title": "Navegador web",
        "RequiresConsent": true,
        "ConsentNote": "Pulsa Conectar para activarlo: descargará Playwright (de Microsoft, versión 0.0.84) desde npm la primera vez.",
        "Instructions": "Es un Edge propio de Kroko (separado del navegador personal de tu dueño). Para leer una página usa browser_snapshot. Antes de comprar, pagar, publicar, enviar formularios o aceptar términos llama a confirmar_accion. Nunca escribas contraseñas ni datos de tarjeta: si una web pide iniciar sesión, pídele a tu dueño que lo haga él en esa ventana.",
        "Command": "cmd.exe",
        "Args": [ "/c", "npx", "-y", "@playwright/mcp@0.0.84", "--browser", "msedge", "--user-data-dir", "%LOCALAPPDATA%\\Kroko\\navegador" ],
        "ReadOnlyTools": [ "browser_snapshot", "browser_take_screenshot", "browser_console_messages", "browser_network_requests", "browser_find", "browser_navigate", "browser_navigate_back", "browser_tabs", "browser_wait_for", "browser_resize", "browser_close" ],
        "WriteTools": [ "browser_click", "browser_type", "browser_hover", "browser_select_option", "browser_press_key", "browser_fill_form", "browser_drag", "browser_handle_dialog" ],
        "DisabledTools": [ "browser_run_code_unsafe", "browser_evaluate", "browser_file_upload", "browser_drop", "browser_install", "browser_cookie*", "browser_localstorage*", "browser_sessionstorage*", "browser_storage_state", "browser_set_storage_state", "browser_route*", "browser_unroute", "browser_network_state_set" ],
        "DefaultRisk": "Dangerous"
      },
      "notion": {
        "Enabled": true,
        "Title": "Notion",
        "Instructions": "Workspace de Notion de tu dueño. Para GUARDAR notas o agenda usa guardar_en_notion (un solo paso). Para leer o buscar, notion-search y notion-fetch. Editar, mover, duplicar, comentar o borrar lo existente pide permiso.",
        "Url": "https://mcp.notion.com/mcp",
        "OAuth": true,
        "ReadOnlyTools": [ "notion-search", "notion-fetch", "notion-get*", "notion-list*", "notion-query*" ],
        "WriteTools": [ "notion-create-pages", "notion-create-database", "notion-create-view" ],
        "DefaultRisk": "Dangerous"
      },
      "todoist": {
        "Enabled": true,
        "Title": "Todoist",
        "Instructions": "Tareas de tu dueño en Todoist. Para 'qué tengo pendiente' busca las de hoy y las vencidas. Completar o crear tareas es normal; borrar pide confirmación.",
        "Url": "https://ai.todoist.net/mcp",
        "OAuth": true,
        "ReadOnlyTools": [ "find*", "get*", "search", "fetch", "user-info", "list*" ],
        "WriteTools": [ "add*", "update*", "complete*", "uncomplete*", "reschedule*", "move*" ],
        "DangerousTools": [ "delete*" ],
        "DefaultRisk": "Dangerous"
      }
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  }
}
