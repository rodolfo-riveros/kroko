<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Paleta de Kroko (estilo Troko: ojos blancos sobre pantalla negra, acentos lima).
        Cambia aquí un color y se actualiza en toda la App.
    -->
    <Color x:Key="Kroko.BodyColor">#0F0F0F</Color>
    <Color x:Key="Kroko.BodyEdgeColor">#2A2A2A</Color>
    <Color x:Key="Kroko.EyeColor">#FFFFFF</Color>
    <Color x:Key="Kroko.AccentColor">#A3FF6A</Color>
    <Color x:Key="Kroko.EyeAlertColor">#FFB547</Color>
    <Color x:Key="Kroko.EyeErrorColor">#FF5C6C</Color>
    <Color x:Key="Kroko.EyeLoveColor">#FF7EB6</Color>
    <Color x:Key="Kroko.BlushColor">#73FF7EB6</Color>
    <Color x:Key="Kroko.TearColor">#4DA3FF</Color>
    <Color x:Key="Kroko.PurpleColor">#A85FF7</Color>
    <Color x:Key="Kroko.PanelColor">#EB0F0F0F</Color>
    <Color x:Key="Kroko.TextColor">#F5F1E9</Color>
    <Color x:Key="Kroko.TextMutedColor">#B9B5AA</Color>

    <SolidColorBrush x:Key="Kroko.Body" Color="{StaticResource Kroko.BodyColor}" />
    <SolidColorBrush x:Key="Kroko.BodyEdge" Color="{StaticResource Kroko.BodyEdgeColor}" />
    <SolidColorBrush x:Key="Kroko.Eye" Color="{StaticResource Kroko.EyeColor}" />
    <SolidColorBrush x:Key="Kroko.Accent" Color="{StaticResource Kroko.AccentColor}" />
    <SolidColorBrush x:Key="Kroko.EyeAlert" Color="{StaticResource Kroko.EyeAlertColor}" />
    <SolidColorBrush x:Key="Kroko.EyeError" Color="{StaticResource Kroko.EyeErrorColor}" />
    <SolidColorBrush x:Key="Kroko.EyeLove" Color="{StaticResource Kroko.EyeLoveColor}" />
    <SolidColorBrush x:Key="Kroko.Blush" Color="{StaticResource Kroko.BlushColor}" />
    <SolidColorBrush x:Key="Kroko.Tear" Color="{StaticResource Kroko.TearColor}" />
    <SolidColorBrush x:Key="Kroko.Purple" Color="{StaticResource Kroko.PurpleColor}" />
    <SolidColorBrush x:Key="Kroko.Panel" Color="{StaticResource Kroko.PanelColor}" />
    <SolidColorBrush x:Key="Kroko.Text" Color="{StaticResource Kroko.TextColor}" />
    <SolidColorBrush x:Key="Kroko.TextMuted" Color="{StaticResource Kroko.TextMutedColor}" />

    <FontFamily x:Key="Kroko.Font">Segoe UI Variable Text, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="Kroko.Window" Color="#0F0F0F" />
    <SolidColorBrush x:Key="Kroko.Surface" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Kroko.SurfaceHover" Color="#232323" />
    <SolidColorBrush x:Key="Kroko.Line" Color="#24F5F1E9" />
    <SolidColorBrush x:Key="Kroko.OnAccent" Color="#0F0F0F" />

    <!-- Tarjeta con borde fino -->
    <Style x:Key="Kroko.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Kroko.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Kroko.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Etiqueta de sección estilo "mono" -->
    <Style x:Key="Kroko.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Kroko.Accent}" />
        <Setter Property="Margin" Value="0,18,0,8" />
    </Style>

    <!--
        Botones estilo Windows 11: rectángulo con esquinas de 6 px, alto fijo, relleno sutil.
        Kroko.Button = secundario · Kroko.PrimaryButton = acción principal (lima) · Kroko.ConfirmButton = "Sí, hazlo" (ámbar)
    -->
    <Style x:Key="Kroko.Button" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Kroko.Text}" />
        <Setter Property="Background" Value="#262626" />
        <Setter Property="BorderBrush" Value="#33F5F1E9" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" />
                        <!-- Capa para oscurecer/aclarar al pasar el ratón sin cambiar el color base -->
                        <Border x:Name="Tint" CornerRadius="6" Background="Transparent" />
                        <Border x:Name="Focus" CornerRadius="7" BorderThickness="2" BorderBrush="{StaticResource Kroko.Text}"
                                Margin="-3" Visibility="Collapsed" />
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tint" Property="Background" Value="#0FFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Tint" Property="Background" Value="#26000000" />
                            <Setter TargetName="Content" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Acción principal (lima) -->
    <Style x:Key="Kroko.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Kroko.Button}">
        <Setter Property="Foreground" Value="{StaticResource Kroko.OnAccent}" />
        <Setter Property="Background" Value="{StaticResource Kroko.Accent}" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <!-- "Sí, hazlo" de la tarjeta de confirmación (ámbar) -->
    <Style x:Key="Kroko.ConfirmButton" TargetType="Button" BasedOn="{StaticResource Kroko.Button}">
        <Setter Property="Foreground" Value="{StaticResource Kroko.OnAccent}" />
        <Setter Property="Background" Value="{StaticResource Kroko.EyeAlert}" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- Casilla con check lima -->
    <Style x:Key="Kroko.Check" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Kroko.Text}" />
        <Setter Property="Margin" Value="0,0,16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1"
                                BorderBrush="{StaticResource Kroko.Line}" Background="{StaticResource Kroko.Window}">
                            <Path x:Name="Mark" Data="M 4,9 L 7.5,12.5 L 14,5.5" Stroke="{StaticResource Kroko.OnAccent}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Kroko.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Kroko.Accent}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Kroko.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lista en mosaico (galería) -->
    <Style x:Key="Kroko.TileList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Kroko.Text}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Width" Value="128" />
                    <Setter Property="Height" Value="84" />
                    <Setter Property="Margin" Value="0,0,10,10" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Foreground" Value="{StaticResource Kroko.Text}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Black" BorderBrush="{StaticResource Kroko.Line}"
                                        BorderThickness="1" CornerRadius="14" Padding="12,10">
                                    <ContentPresenter VerticalAlignment="Top" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Kroko.SurfaceHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Kroko.Accent}" />
                                        <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Iconos (Windows 11; en Windows 10 cae a MDL2) -->
    <FontFamily x:Key="Kroko.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Interruptor estilo Windows 11 (para CheckBox) -->
    <Style x:Key="Kroko.Toggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{StaticResource Kroko.TextMuted}" Background="Transparent" />
                        <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{StaticResource Kroko.TextMuted}"
                                 HorizontalAlignment="Left" Margin="4,0,0,0">
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Kroko.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Kroko.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Kroko.OnAccent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Kroko.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campo de texto -->
    <Style x:Key="Kroko.Field" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Kroko.Window}" />
        <Setter Property="Foreground" Value="{StaticResource Kroko.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Kroko.Line}" />
        <Setter Property="CaretBrush" Value="{StaticResource Kroko.Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Kroko.Accent}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Kroko.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Desplegable oscuro -->
    <Style x:Key="Kroko.Combo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Kroko.Text}" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{StaticResource Kroko.Window}" BorderBrush="{StaticResource Kroko.Line}"
                                            BorderThickness="1" CornerRadius="6">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                              Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Kroko.TextMuted}" StrokeThickness="1.5" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Kroko.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="10,0,30,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource Kroko.Surface}" BorderBrush="{StaticResource Kroko.Line}" BorderThickness="1"
                                    CornerRadius="6" Margin="0,2,0,0" MaxHeight="280"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource Kroko.Text}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Padding="10,6" Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Kroko.SurfaceHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Kroko.Accent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de progreso lima -->
    <Style x:Key="Kroko.Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{StaticResource Kroko.SurfaceHover}" />
                        <Border x:Name="PART_Indicator" CornerRadius="3" Background="{StaticResource Kroko.Accent}" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barras de desplazamiento finas y oscuras (para toda la App) -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="T" CornerRadius="3" Background="#33F5F1E9" Margin="1,2" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="T" Property="Background" Value="#66F5F1E9" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#33F5F1E9" Margin="2,1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Deslizador estilo Windows 11 (parte llena en lima) para toda la App -->
    <Style x:Key="Kroko.SliderRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="Slider.DecreaseLarge" Background="{StaticResource Kroko.Accent}" Style="{StaticResource Kroko.SliderRepeat}" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="Slider.IncreaseLarge" Background="#40F5F1E9" Style="{StaticResource Kroko.SliderRepeat}" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Width="20" Height="20">
                                            <Ellipse Fill="{StaticResource Kroko.SurfaceHover}" Stroke="{StaticResource Kroko.Line}" StrokeThickness="1" />
                                            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource Kroko.Accent}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Dot" Property="Width" Value="13" />
                                                <Setter TargetName="Dot" Property="Height" Value="13" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campo de contraseña / clave (mismo aspecto que Kroko.Field) -->
    <Style x:Key="Kroko.Secret" TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Kroko.Window}" />
        <Setter Property="Foreground" Value="{StaticResource Kroko.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Kroko.Line}" />
        <Setter Property="CaretBrush" Value="{StaticResource Kroko.Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Kroko.Accent}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Kroko.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
