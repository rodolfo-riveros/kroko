<Window x:Class="Kroko.App.Views.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:face="clr-namespace:Kroko.App.Face"
        xmlns:v="clr-namespace:Kroko.App.Views"
        Title="Kroko"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        UseLayoutRounding="True"
        Opacity="0">

    <Window.Resources>
        <!-- Menú corto (14/11/2026): lo demás está en el panel «Kroko». Lo comparten la burbuja y la isla. -->
        <ContextMenu x:Key="KrokoMenu">
            <MenuItem Header="Abrir Kroko" FontWeight="SemiBold" Command="{Binding OpenPanelCommand}" CommandParameter="inicio" />
            <MenuItem Header="Hablar" InputGestureText="Ctrl+Espacio" Command="{Binding TalkCommand}" />
            <MenuItem Header="Escribir a Kroko" Command="{Binding WriteCommand}" />
            <Separator />
            <MenuItem Header="Hábitos" Command="{Binding OpenPanelCommand}" CommandParameter="habitos" />
            <MenuItem Header="Tareas y avisos" Command="{Binding OpenPanelCommand}" CommandParameter="tareas" />
            <MenuItem Header="Enfoque (pomodoro)" Command="{Binding OpenPanelCommand}" CommandParameter="enfoque" />
            <Separator />
            <MenuItem Header="Configuración" Command="{Binding OpenSettingsCommand}" />
            <MenuItem Header="Pausar / reanudar" InputGestureText="Ctrl+Alt+K" Command="{Binding TogglePauseCommand}" />
            <MenuItem Header="Esconder (descansa)" Command="{Binding RestCommand}" />
            <MenuItem Header="Salir" Command="{Binding ExitCommand}" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <!--
            Burbuja: todo el lienzo es transparente salvo el cuerpo de Kroko: los clics fuera de él
            pasan a las ventanas de abajo (click-through).
        -->
        <face:FaceView x:Name="Face"
                       Animator="{Binding Face}"
                       Cursor="Hand"
                       ContextMenu="{StaticResource KrokoMenu}"
                       MouseLeftButtonDown="Face_MouseLeftButtonDown"
                       MouseMove="Face_MouseMove"
                       MouseLeftButtonUp="Face_MouseLeftButtonUp"
                       LostMouseCapture="Face_LostMouseCapture"
                       MouseEnter="Face_MouseEnter"
                       MouseLeave="Face_MouseLeave" />

        <!-- Isla de arriba (17/11/2026, como Troko Desk): se ensancha al pasar el mouse o cuando hay algo que contar -->
        <v:IslandView x:Name="Island" Visibility="Collapsed" Width="150"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      ContextMenu="{StaticResource KrokoMenu}"
                      MouseLeftButtonUp="Island_MouseLeftButtonUp"
                      MouseEnter="Island_MouseEnter"
                      MouseLeave="Island_MouseLeave" />
    </Grid>
</Window>
