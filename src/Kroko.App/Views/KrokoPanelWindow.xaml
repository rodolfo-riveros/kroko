<Window x:Class="Kroko.App.Views.KrokoPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Kroko.App.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Kroko"
        Width="1120" Height="740" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource Kroko.MacWindow}"
        Foreground="{StaticResource Kroko.Text}"
        FontFamily="{StaticResource Kroko.Font}"
        FontSize="13">

    <Window.Resources>
        <v:BoolToVisibleConverter x:Key="BoolToVisible" />
        <v:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
        <v:ProgressToDashConverter x:Key="ProgressToDash" />
        <v:FractionConverter x:Key="Fraction" />

        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource Kroko.Field}">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Kroko.TextMuted}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Group" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="2,20,0,8" />
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Kroko.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Kroko.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="52" />
        </Style>
        <!-- Kroko 2 (18/11/2026): icono gris de la barra lateral; lima en la sección abierta -->
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Kroko.Icons}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Kroko.NavText}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Kroko.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IconDot" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Contador gris (Tareas 4) y etiqueta lima «NUEVO» de la barra lateral -->
        <Style x:Key="NavCount" TargetType="Border">
            <Setter Property="Background" Value="#26262A" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="NewTag" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Kroko.Accent}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <!-- Botón pequeño solo con icono (borrar, quitar) -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Kroko.Button}">
            <Setter Property="FontFamily" Value="{StaticResource Kroko.Icons}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <!-- Chip de ejemplo (diseño Kroko 2: píldora con borde, sin relleno; lima al pasar el mouse) -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Kroko.NavText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="17" BorderThickness="1" BorderBrush="{StaticResource Kroko.ChipLine}"
                                Background="Transparent" Padding="14,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Kroko.Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Kroko.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Botón gris píldora pequeño (Deshacer, Abrir, Ver) -->
        <Style x:Key="Mini" TargetType="Button" BasedOn="{StaticResource Kroko.Button}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="0,0,14,0" />
        </Style>

        <!-- Navegación lateral Kroko 2: fila de 38 px, esquinas de 12; abierta = fondo verde oscuro #1A1D12 y letra blanca -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Kroko.NavText}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,0,2" Cursor="Hand">
                            <Border x:Name="Bd" CornerRadius="12" Padding="12,9" Background="Transparent">
                                <ContentPresenter ContentSource="Header" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#151517" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1D12" />
                                <Setter Property="Foreground" Value="{StaticResource Kroko.Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de la barra lateral que no es pestaña (Configuración, Salir): icono en Tag, texto en Content -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Kroko.NavText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Padding="12,9" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Kroko.Icons}" FontSize="15" Width="20" Margin="0,0,12,0"
                                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Content}" FontSize="14" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#151517" />
                                <Setter Property="Foreground" Value="{StaticResource Kroko.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Un archivo de la bandeja: etiqueta de color con el tipo y el nombre; se arrastra a cualquier app -->
        <DataTemplate x:Key="TrayTile">
            <Border Background="{StaticResource Kroko.Inset}" BorderBrush="{StaticResource Kroko.ChipLine}" BorderThickness="1" CornerRadius="12"
                    Padding="10,8,14,8" Margin="0,0,10,10" Cursor="Hand" ToolTip="{Binding Path}"
                    PreviewMouseLeftButtonDown="TrayTile_MouseDown" PreviewMouseMove="TrayTile_MouseMove">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}" />
                </Border.InputBindings>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Abrir" Command="{Binding OpenCommand}" />
                        <MenuItem Header="Mostrar en la carpeta" Command="{Binding ShowInFolderCommand}" />
                        <MenuItem Header="Quitar de la bandeja" Command="{Binding RemoveCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="38" CornerRadius="5" Background="{Binding KindColor}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Kind}" FontSize="9" FontWeight="ExtraBold" Foreground="#000000"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- «Suelta más aquí»: recuadro punteado al final de la bandeja -->
        <ControlTemplate x:Key="DropHere" TargetType="ContentControl">
                    <Grid Width="140" Height="56" Margin="0,0,10,10">
                        <Rectangle RadiusX="12" RadiusY="12" Stroke="#3A3A3F" StrokeThickness="1" StrokeDashArray="4,3" />
                        <TextBlock Text="Suelta más aquí" FontSize="13" Foreground="{StaticResource Kroko.TextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
        </ControlTemplate>

        <!-- Los 7 días de la semana de un hábito -->
        <DataTemplate x:Key="WeekDot">
            <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,0,4,0" Fill="{StaticResource Kroko.Line}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Kroko.Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Horizontal">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- Fila de un interruptor de ajustes -->
        <Style x:Key="ToggleRow" TargetType="CheckBox" BasedOn="{StaticResource Kroko.Toggle}">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <TabControl TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Padding="32,26,18,18"
                SelectedIndex="{Binding SelectedSection}">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <DockPanel>
                    <!-- Barra lateral Kroko 2: negra, con línea a la derecha -->
                    <Border DockPanel.Dock="Left" Width="232" Background="#000000" BorderBrush="#1A1A1D" BorderThickness="0,0,1,0">
                        <DockPanel LastChildFill="False" Margin="14,18,14,14">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                                <v:KrokoMark Width="46" Height="36" />
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Kroko" FontWeight="Bold" FontSize="16" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,1,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource Kroko.Accent}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOffline}" Value="True"><Setter Property="Fill" Value="#6E6E73" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock FontSize="12" TextWrapping="Wrap" MaxWidth="140">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Listo · cerebro conectado" />
                                                    <Setter Property="Foreground" Value="{StaticResource Kroko.Accent}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                                            <Setter Property="Text" Value="Sin cerebro · modo local" />
                                                            <Setter Property="Foreground" Value="{StaticResource Kroko.TextMuted}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <TabPanel DockPanel.Dock="Top" IsItemsHost="True" />
                            <!-- Salir de Kroko: lo último de la barra -->
                            <Button DockPanel.Dock="Bottom" Command="{Binding QuitKrokoCommand}" Style="{StaticResource NavButton}" Tag="&#xE7E8;" Content="Salir de Kroko" />
                            <!-- Toda la configuración en una sola ventana -->
                            <Button DockPanel.Dock="Bottom" Command="{Binding OpenAdvancedCommand}" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Configuración" Margin="0,0,0,2" />
                        </DockPanel>
                    </Border>
                    <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" />
                </DockPanel>
            </ControlTemplate>
        </TabControl.Template>

        <!-- ============================== Inicio (diseño Kroko 2, 18/11/2026) ============================== -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal"><Border Style="{StaticResource IconDot}"><TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" /></Border><TextBlock Text="Inicio" VerticalAlignment="Center" /></StackPanel>
            </TabItem.Header>
            <ScrollViewer>
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" VerticalAlignment="Bottom" CornerRadius="15" BorderThickness="1"
                                BorderBrush="{StaticResource Kroko.ChipLine}" Padding="12,6">
                            <TextBlock Text="Ctrl + Espacio para hablarle desde cualquier lugar" FontSize="12" Foreground="{StaticResource Kroko.TextMuted}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding Greeting}" FontSize="32" FontWeight="Bold" />
                            <TextBlock FontSize="14" Foreground="{StaticResource Kroko.TextMuted}" Margin="0,4,0,0">
                                <Run Text="{Binding WeekdayDateText, Mode=OneWay}" /><Run Text=" · tu resumen de hoy" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <Border Background="{StaticResource Kroko.Accent}" CornerRadius="14" Padding="16,11" Margin="0,18,0,0"
                            Visibility="{Binding Celebration, Converter={StaticResource EmptyToCollapsed}}">
                        <TextBlock Text="{Binding Celebration}" Foreground="{StaticResource Kroko.OnAccent}" FontWeight="SemiBold" FontSize="14" />
                    </Border>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Kroko.Amber}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding Status, Converter={StaticResource EmptyToCollapsed}}" />

                    <!-- Escribe, habla o suelta un archivo -->
                    <Border Style="{StaticResource Kroko.Card}" Margin="0,20,0,0" Padding="18,18,18,10">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Enviar" Command="{Binding AskCommand}" Style="{StaticResource Kroko.PrimaryButton}"
                                        Height="48" MinWidth="84" Margin="10,0,0,0" />
                                <Button DockPanel.Dock="Right" Command="{Binding TalkCommand}" Style="{StaticResource Kroko.Button}" ToolTip="Hablar (Ctrl+Espacio)"
                                        Width="48" Height="48" MinWidth="48" Padding="0" Margin="10,0,0,0">
                                    <TextBlock Text="&#xE720;" FontFamily="{StaticResource Kroko.Icons}" FontSize="15" />
                                </Button>
                                <TextBox Text="{Binding AskText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Height="50"
                                         FontSize="14" Tag="Escribe, habla o suelta un archivo aquí…" AllowDrop="True"
                                         PreviewDragOver="AskBox_PreviewDragOver" PreviewDrop="AskBox_PreviewDrop">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding AskCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="Anota una tarea" Style="{StaticResource Chip}" Command="{Binding ExampleCommand}" CommandParameter="Anota una tarea: " />
                                <Button Content="Enfócate 25 minutos" Style="{StaticResource Chip}" Command="{Binding ExampleCommand}" CommandParameter="Enfócate 25 minutos" />
                                <Button Content="Ordena mis Descargas" Style="{StaticResource Chip}" Command="{Binding ExampleCommand}" CommandParameter="Ordena mis Descargas" />
                                <Button Content="Resume mi correo" Style="{StaticResource Chip}" Command="{Binding ExampleCommand}" CommandParameter="Resume mi correo importante" />
                                <Button Content="Convierte la última foto a PDF" Style="{StaticResource Chip}" Command="{Binding ExampleCommand}" CommandParameter="Convierte a PDF la última foto de mis Descargas" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Cuatro cifras del día -->
                    <UniformGrid Columns="4" Margin="-6,14,-6,0">
                        <Border Style="{StaticResource Kroko.Card}" Margin="6,0" Padding="18">
                            <DockPanel>
                                <Grid Width="40" Height="40" DockPanel.Dock="Left" Margin="0,0,12,0">
                                    <Ellipse Stroke="#26262A" StrokeThickness="5" />
                                    <Ellipse Stroke="{StaticResource Kroko.Accent}" StrokeThickness="5" StrokeDashCap="Round"
                                             StrokeDashArray="{Binding DayProgress, Converter={StaticResource ProgressToDash}, ConverterParameter='40,5'}"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><RotateTransform Angle="-90" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HabitsDoneText}" FontSize="24" FontWeight="Bold" />
                                    <TextBlock Text="hábitos de hoy" FontSize="13" Foreground="{StaticResource Kroko.TextMuted}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Kroko.Card}" Margin="6,0" Padding="18">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding PendingTasksValue}" FontSize="24" FontWeight="Bold" />
                                <TextBlock Text="tareas pendientes" FontSize="13" Foreground="{StaticResource Kroko.TextMuted}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Kroko.Card}" Margin="6,0" Padding="18">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding FocusMinutesText}" FontSize="24" FontWeight="Bold" />
                                <TextBlock Text="de enfoque hoy" FontSize="13" Foreground="{StaticResource Kroko.TextMuted}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Kroko.Card}" Margin="6,0" Padding="18">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding NextNoticeValue}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Kroko.Amber}" />
                                <TextBlock FontSize="13" Foreground="{StaticResource Kroko.TextMuted}" TextTrimming="CharacterEllipsis">
                                    <Run Text="próximo aviso · " /><Run Text="{Binding NextNoticeLabel, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Tareas de hoy · Lo que hizo Kroko -->
                    <UniformGrid Columns="2" Margin="-6,14,-6,0">
                        <Border Style="{StaticResource Kroko.Card}" Margin="6,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Content="Ver todas" Command="{Binding OpenSectionCommand}" CommandParameter="tareas"
                                            Style="{StaticResource Kroko.TextButton}" Padding="2,0" FontWeight="Normal" FontSize="13" />
                                    <TextBlock Text="Tareas de hoy" FontSize="16" FontWeight="SemiBold" />
                                </DockPanel>
                                <TextBlock Text="Nada pendiente. Dime «anota…» y la agrego." FontSize="13" Foreground="{StaticResource Kroko.TextMuted}"
                                           Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVisible}}" />
                                <ItemsControl ItemsSource="{Binding TodayTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Done}" Command="{Binding ToggleCommand}" Style="{StaticResource Kroko.Check}" Margin="0,0,0,10">
                                                <TextBlock x:Name="T" Text="{Binding Text}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            </CheckBox>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Done}" Value="True">
                                                    <Setter TargetName="T" Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter TargetName="T" Property="Foreground" Value="{StaticResource Kroko.TextMuted}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Kroko.Card}" Margin="6,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock DockPanel.Dock="Right" Text="todo se puede deshacer" FontSize="12" Foreground="{StaticResource Kroko.TextMuted}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Lo que hizo Kroko" FontSize="16" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource NewTag}" Margin="8,0,0,0"><TextBlock Text="NUEVO" FontSize="10" FontWeight="Bold" Foreground="#000000" /></Border>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="Hoy todavía no hice nada. Pídeme algo y aquí lo verás." FontSize="13" Foreground="{StaticResource Kroko.TextMuted}"
                                           TextWrapping="Wrap" Visibility="{Binding HasNoActivity, Converter={StaticResource BoolToVisible}}" />
                                <ItemsControl ItemsSource="{Binding Activity.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,10">
                                                <Button DockPanel.Dock="Right" Content="{Binding ActionLabel}" Command="{Binding RunCommand}" Style="{StaticResource Mini}"
                                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVisible}}" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" FontSize="12" Width="44" Foreground="{StaticResource Kroko.TextMuted}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Text}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Bandeja -->
                    <Border Style="{StaticResource Kroko.Card}" Margin="0,14,0,0" AllowDrop="True" Drop="Tray_Drop" DragOver="Tray_DragOver">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Right" Text="Archivos estacionados en la isla. Arrástralos a cualquier app." FontSize="13"
                                           Foreground="{StaticResource Kroko.TextMuted}" VerticalAlignment="Center" />
                                <TextBlock Text="Bandeja" FontSize="16" FontWeight="SemiBold" />
                            </DockPanel>
                            <WrapPanel>
                                <ItemsControl ItemsSource="{Binding Tray.Items}" ItemTemplate="{StaticResource TrayTile}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <ContentControl Template="{StaticResource DropHere}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================== Chat (17/11/2026, como en Troko Desk) ============================== -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal"><Border Style="{StaticResource IconDot}"><TextBlock Text="&#xE8BD;" Style="{StaticResource Icon}" /></Border><TextBlock Text="Chat" VerticalAlignment="Center" /></StackPanel>
            </TabItem.Header>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Actualizar" Command="{Binding LoadChatCommand}" Style="{StaticResource Kroko.Button}" VerticalAlignment="Center" />
                        <TextBlock Text="Chat" Style="{StaticResource PageTitle}" />
                    </DockPanel>
                    <TextBlock Text="Habla o escribe con Kroko. Aquí ves lo que le pediste, lo que respondió y lo que hizo." Style="{StaticResource Sub}" Margin="0,2,0,10" />
                    <TextBlock Text="{Binding ChatStatus}" Style="{StaticResource Sub}" Margin="0,0,0,8"
                               Visibility="{Binding ChatStatus, Converter={StaticResource EmptyToCollapsed}}" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource Kroko.Card}" Margin="0,10,0,0" Padding="12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Enviar" Command="{Binding AskCommand}" Style="{StaticResource Kroko.PrimaryButton}" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Command="{Binding TalkCommand}" Style="{StaticResource Kroko.Button}" Margin="8,0,0,0" ToolTip="Hablar (Ctrl+Espacio)">
                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource Kroko.Icons}" />
                        </Button>
                        <TextBox Text="{Binding AskText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" VerticalContentAlignment="Center"
                                 Tag="Escribe a Kroko…">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AskCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                </Border>

                <ScrollViewer x:Name="ChatScroll">
                    <ItemsControl ItemsSource="{Binding ChatLines}" Margin="0,0,8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <!-- Lo que dijiste: a la derecha, en lima -->
                                    <Border HorizontalAlignment="Right" MaxWidth="460" CornerRadius="14,14,4,14" Padding="12,8"
                                            Background="{StaticResource Kroko.Accent}"
                                            Visibility="{Binding IsMine, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource Kroko.OnAccent}" />
                                    </Border>
                                    <!-- Lo que respondió Kroko: a la izquierda, en vidrio -->
                                    <Border HorizontalAlignment="Left" MaxWidth="520" CornerRadius="14,14,14,4" Padding="12,8"
                                            Background="{StaticResource Kroko.Surface}" BorderBrush="{StaticResource Kroko.GlassEdge}" BorderThickness="1"
                                            Visibility="{Binding IsKroko, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </Border>
                                    <!-- Lo que hizo: un check verde con la palabra -->
                                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="4,0,0,0"
                                                Visibility="{Binding IsAction, Converter={StaticResource BoolToVisible}}">
                                        <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Kroko.Accent}" Margin="0,0,6,0">
                                            <Path Data="M3.5,8.2 L6.6,11.2 L12.5,4.8" Stroke="{StaticResource Kroko.OnAccent}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Border>
                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource Kroko.Accent}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ============================== Tareas ============================== -->
        <TabItem>
            <TabItem.Header>
                <DockPanel LastChildFill="True"><Border DockPanel.Dock="Right" Style="{StaticResource NavCount}" Visibility="{Binding PendingTasksBadgeVisible, Converter={StaticResource BoolToVisible}}"><TextBlock Text="{Binding PendingTasksValue}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Kroko.NavText}" /></Border><Border DockPanel.Dock="Left" Style="{StaticResource IconDot}"><TextBlock Text="&#xE73A;" Style="{StaticResource Icon}" /></Border><TextBlock Text="Tareas" VerticalAlignment="Center" /></DockPanel>
            </TabItem.Header>
            <ScrollViewer>
                <StackPanel>
                    <TextBlock Text="Tareas y avisos" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Lo que tienes que hacer y lo que te voy a recordar. Por voz: «anota una tarea…», «recuérdame…»." Style="{StaticResource Sub}" Margin="0,2,0,14" />

                    <Border Style="{StaticResource Kroko.Card}" Padding="12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Añadir" Command="{Binding AddTaskCommand}" Style="{StaticResource Kroko.PrimaryButton}" Margin="10,0,0,0" />
                            <CheckBox DockPanel.Dock="Right" Content="Para hoy" IsChecked="{Binding NewTaskToday}" Style="{StaticResource Kroko.Check}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBox Text="{Binding NewTaskText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Tag="Nueva tarea…">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddTaskCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="Pendientes" Style="{StaticResource Group}" />
                    <TextBlock Text="¡Nada pendiente! 🎉" Style="{StaticResource Sub}" Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVisible}}" />
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="&#xE74D;" ToolTip="Borrar" Command="{Binding DeleteCommand}" Style="{StaticResource IconButton}" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        <CheckBox IsChecked="{Binding Done}" Style="{StaticResource Kroko.Check}" VerticalAlignment="Center" VerticalContentAlignment="Center">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Próximos avisos" Style="{StaticResource Group}" />
                    <TextBlock Text="No tienes avisos programados." Style="{StaticResource Sub}" Visibility="{Binding HasNoReminders, Converter={StaticResource BoolToVisible}}" />
                    <ItemsControl ItemsSource="{Binding Reminders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="&#xE74D;" ToolTip="Quitar aviso" Command="{Binding DeleteCommand}" Style="{StaticResource IconButton}" />
                                        <TextBlock DockPanel.Dock="Left" Text="&#xEA8F;" Style="{StaticResource Icon}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding When}" Style="{StaticResource Sub}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================== Hábitos ============================== -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal"><Border Style="{StaticResource IconDot}"><TextBlock Text="&#xE734;" Style="{StaticResource Icon}" /></Border><TextBlock Text="Hábitos" VerticalAlignment="Center" /><TextBlock Text="{Binding DayProgressText}" Margin="10,0,0,0" FontSize="11.5" Foreground="{StaticResource Kroko.TextMuted}" VerticalAlignment="Center" /></StackPanel>
            </TabItem.Header>
            <ScrollViewer>
                <StackPanel>
                    <TextBlock Text="Hábitos" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Metas diarias, rachas y avisos. Cuando cumples una meta, lo celebro. Por voz: «tomé un vaso de agua», «ya leí»." Style="{StaticResource Sub}" Margin="0,2,0,14" />

                    <Border Background="{StaticResource Kroko.Accent}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                            Visibility="{Binding Celebration, Converter={StaticResource EmptyToCollapsed}}">
                        <TextBlock Text="{Binding Celebration}" Foreground="{StaticResource Kroko.OnAccent}" FontWeight="SemiBold" FontSize="14" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Habits}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Kroko.Card}" Width="290" Margin="0,0,10,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="&#xE74D;" ToolTip="Dejar de seguir" Command="{Binding DeleteCommand}" Style="{StaticResource IconButton}" />
                                            <Button DockPanel.Dock="Right" Content="&#xE72C;" ToolTip="Reiniciar hoy" Command="{Binding ResetCommand}" Style="{StaticResource IconButton}" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Emoji}" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StreakText}" Style="{StaticResource Sub}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Margin="0,14,0,6">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Sub}" Margin="10,0,0,0" />
                                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Style="{StaticResource Kroko.Progress}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DockPanel Margin="0,6,0,0">
                                            <Button DockPanel.Dock="Right" Content="{Binding AddText}" Command="{Binding AddCommand}" Style="{StaticResource Kroko.PrimaryButton}" MinWidth="64" Margin="0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Últimos 7 días" Style="{StaticResource Sub}" FontSize="11" Margin="0,0,0,4" />
                                                <ItemsControl ItemsSource="{Binding Week}" ItemTemplate="{StaticResource WeekDot}" ItemsPanel="{StaticResource Horizontal}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Nuevo hábito" Style="{StaticResource Group}" />
                    <Border Style="{StaticResource Kroko.Card}" Padding="14">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Crear hábito" Command="{Binding AddHabitCommand}" Style="{StaticResource Kroko.PrimaryButton}" Margin="10,0,0,0" />
                                <TextBox DockPanel.Dock="Right" Width="110" Text="{Binding NewHabitUnit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Tag="vasos, páginas…" Margin="8,0,0,0" ToolTip="Unidad (opcional)" />
                                <TextBox DockPanel.Dock="Right" Width="60" Text="{Binding NewHabitGoal, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Margin="8,0,0,0" ToolTip="Meta por día" />
                                <TextBox Text="{Binding NewHabitName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Tag="Beber agua, Leer, Ejercicio…">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding AddHabitCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource Sub}"
                                       Text="Nombre · meta por día · unidad. Ejemplo: «Beber agua · 8 · vasos». Para avisos a ciertas horas dímelo: «recuérdame tomar agua a las 10 y a las 4»." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================== Enfoque ============================== -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal"><Border Style="{StaticResource IconDot}"><TextBlock Text="&#xE916;" Style="{StaticResource Icon}" /></Border><TextBlock Text="Enfoque" VerticalAlignment="Center" /><TextBlock Text="{Binding Timers.RemainingText}" Margin="10,0,0,0" FontSize="11.5" Foreground="{StaticResource Kroko.Accent}" VerticalAlignment="Center" /></StackPanel>
            </TabItem.Header>
            <ScrollViewer>
                <StackPanel>
                    <TextBlock Text="Enfoque" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Bloques de concentración con descansos. Mientras corre, silencio tus notificaciones y la cuenta atrás se ve en la isla." Style="{StaticResource Sub}" Margin="0,2,0,18" />

                    <!-- Tarjeta con resplandor verde (estilo Troko, 17/11/2026) -->
                    <Border Style="{StaticResource Kroko.GlowCard}" Padding="26">
                        <DockPanel>
                            <Grid Width="190" Height="190" DockPanel.Dock="Left" Margin="0,0,30,0">
                                <Ellipse Stroke="{StaticResource Kroko.Inset}" StrokeThickness="12" />
                                <Ellipse Stroke="{StaticResource Kroko.Accent}" StrokeThickness="12" StrokeDashCap="Round"
                                         Visibility="{Binding Timers.IsActive, Converter={StaticResource BoolToVisible}}"
                                         StrokeDashArray="{Binding Timers.Progress, Converter={StaticResource ProgressToDash}, ConverterParameter='190,12'}"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><RotateTransform Angle="-90" /></Ellipse.RenderTransform>
                                </Ellipse>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="ENFOQUE" Style="{StaticResource Kroko.Label}" Margin="0" HorizontalAlignment="Center" />
                                    <TextBlock FontSize="40" FontWeight="Bold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Timers.RemainingText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Timers.IsActive}" Value="False">
                                                        <Setter Property="Text" Value="25:00" />
                                                        <Setter Property="Foreground" Value="{StaticResource Kroko.TextMuted}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Sub}">
                                                <Setter Property="Text" Value="{Binding Timers.Label}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Timers.IsActive}" Value="False"><Setter Property="Text" Value="Listo para enfocarte" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Timers.IsPaused}" Value="True"><Setter Property="Text" Value="En pausa" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <StackPanel VerticalAlignment="Center">
                                <!-- Sin nada en marcha: empezar -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Timers.IsActive}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="EMPEZAR" Style="{StaticResource Kroko.Label}" Margin="0,0,0,10" />
                                    <WrapPanel>
                                        <Button Content="25 min" Command="{Binding StartFocusCommand}" CommandParameter="25" Style="{StaticResource Kroko.PrimaryButton}" Margin="0,0,8,8" />
                                        <Button Content="50 min" Command="{Binding StartFocusCommand}" CommandParameter="50" Style="{StaticResource Kroko.Button}" Margin="0,0,8,8" />
                                        <Button Content="Descanso 5 min" Command="{Binding StartBreakCommand}" Style="{StaticResource Kroko.Button}" Margin="0,0,8,8" />
                                    </WrapPanel>
                                </StackPanel>
                                <!-- En marcha: pausar, +5 min, terminar y detener -->
                                <StackPanel Visibility="{Binding Timers.IsActive, Converter={StaticResource BoolToVisible}}">
                                    <WrapPanel>
                                        <Button Command="{Binding PauseFocusCommand}" Margin="0,0,8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Kroko.Button}">
                                                    <Setter Property="Content" Value="Pausar" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Timers.IsPaused}" Value="True"><Setter Property="Content" Value="Seguir" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="+5 min" Command="{Binding AddFiveMinutesCommand}" Style="{StaticResource Kroko.Button}" Margin="0,0,8,8" />
                                        <Button Content="Terminar" Command="{Binding FinishFocusCommand}" Style="{StaticResource Kroko.Button}" Margin="0,0,8,8" />
                                    </WrapPanel>
                                    <Button Content="Detener" Command="{Binding StopFocusCommand}" Style="{StaticResource Kroko.TextButton}" HorizontalAlignment="Left" Margin="-8,0,0,0" />
                                </StackPanel>
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource Sub}" Text="Por voz: «enfócate 25 minutos para estudiar», «descansa»." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- HOY y la semana: barras moradas, la de hoy en verde -->
                    <Border Style="{StaticResource Kroko.Card}" Margin="0,14,0,0" Padding="22,18">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,30,0">
                                <TextBlock Text="HOY" Style="{StaticResource Kroko.Label}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding TodayFocusText}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding FocusBars}" HorizontalAlignment="Right">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,0" ToolTip="{Binding Tip}">
                                            <Grid Height="56" Width="14">
                                                <Border VerticalAlignment="Bottom" CornerRadius="5" Height="{Binding Height, Converter={StaticResource Fraction}, ConverterParameter=56}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource Kroko.Violet}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Background" Value="{StaticResource Kroko.Accent}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Day}" FontSize="11" Foreground="{StaticResource Kroko.TextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================== Correo (17/11/2026, como en Troko Desk) ============================== -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal"><Border Style="{StaticResource IconDot}"><TextBlock Text="&#xE715;" Style="{StaticResource Icon}" /></Border><TextBlock Text="Correo" VerticalAlignment="Center" /></StackPanel>
            </TabItem.Header>
            <ScrollViewer>
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Actualizar" Command="{Binding LoadMailCommand}" Style="{StaticResource Kroko.Button}" VerticalAlignment="Center" />
                        <TextBlock Text="Correo" Style="{StaticResource PageTitle}" />
                    </DockPanel>
                    <TextBlock Text="Tus correos importantes sin leer. Kroko te los resume o te redacta la respuesta, y nunca envía sin tu «sí»." Style="{StaticResource Sub}" Margin="0,2,0,14" />
                    <TextBlock Text="{Binding MailStatus}" Style="{StaticResource Sub}" Margin="0,0,0,10"
                               Visibility="{Binding MailStatus, Converter={StaticResource EmptyToCollapsed}}" />
                    <ItemsControl ItemsSource="{Binding Mails}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Responder con Kroko" Style="{StaticResource Kroko.PrimaryButton}" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.ReplyMailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <Button DockPanel.Dock="Right" Content="Resumir" Style="{StaticResource Kroko.Button}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding DataContext.SummarizeMailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Fecha}" Style="{StaticResource Sub}" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding De}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Asunto}" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================== Bandeja (diseño Kroko 2, 18/11/2026) ============================== -->
        <TabItem>
            <TabItem.Header>
                <DockPanel LastChildFill="True"><Border DockPanel.Dock="Right" Style="{StaticResource NewTag}"><TextBlock Text="NUEVO" FontSize="10" FontWeight="Bold" Foreground="#000000" /></Border><Border DockPanel.Dock="Left" Style="{StaticResource IconDot}"><TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" /></Border><TextBlock Text="Bandeja" VerticalAlignment="Center" /></DockPanel>
            </TabItem.Header>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Content="Vaciar" Command="{Binding ClearTrayCommand}" Style="{StaticResource Kroko.Button}" VerticalAlignment="Bottom"
                            Visibility="{Binding HasNoTrayFiles, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}" />
                    <StackPanel>
                        <TextBlock Text="Bandeja" FontSize="32" FontWeight="Bold" />
                        <TextBlock FontSize="14" Foreground="{StaticResource Kroko.TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Deja archivos aquí mientras cambias de ventana y sácalos arrastrando cuando los necesites. Se vacía sola a las 24 h (sin borrar los originales)." />
                    </StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Kroko.Card}" AllowDrop="True" Drop="Tray_Drop" DragOver="Tray_DragOver" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TrayCountText}" FontSize="13" Foreground="{StaticResource Kroko.TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Text="Estacionados" FontSize="16" FontWeight="SemiBold" />
                        </DockPanel>
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding Tray.Items}" ItemTemplate="{StaticResource TrayTile}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ContentControl Template="{StaticResource DropHere}" />
                        </WrapPanel>
                        <TextBlock FontSize="12" Foreground="{StaticResource Kroko.TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Doble clic abre el archivo; clic derecho para mostrarlo en su carpeta o quitarlo. Al soltar un archivo sobre la isla, «Guardar en la bandeja» lo trae aquí." />
                    </StackPanel>
                </Border>
            </DockPanel>
        </TabItem>

        <!-- ============================== Mi PC ============================== -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal"><Border Style="{StaticResource IconDot}"><TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" /></Border><TextBlock Text="Mi PC" VerticalAlignment="Center" /></StackPanel>
            </TabItem.Header>
            <ScrollViewer>
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Actualizar" Command="{Binding LoadPcCommand}" Style="{StaticResource Kroko.Button}" VerticalAlignment="Center" />
                        <TextBlock Text="Mi PC" Style="{StaticResource PageTitle}" />
                    </DockPanel>
                    <TextBlock Text="{Binding PcSummary}" Style="{StaticResource Sub}" Margin="0,2,0,14" />
                    <ItemsControl ItemsSource="{Binding PcStats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}">
                                    <StackPanel VerticalAlignment="Center">
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Sub}" />
                                            <TextBlock Text="{Binding Name}" />
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Fraction, Mode=OneWay}" Maximum="1" Style="{StaticResource Kroko.Progress}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Acciones rápidas" Style="{StaticResource Group}" />
                    <WrapPanel>
                        <Button Content="Ordenar mi escritorio" Command="{Binding TidyDesktopCommand}" Style="{StaticResource Kroko.Button}" Margin="0,0,8,8" />
                        <Button Content="Deshacer el último orden" Command="{Binding UndoTidyCommand}" Style="{StaticResource Kroko.Button}" Margin="0,0,8,8" />
                        <Button Content="Abrir Descargas" Command="{Binding OpenDownloadsCommand}" Style="{StaticResource Kroko.Button}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding UndoStatus}" Foreground="{StaticResource Kroko.Accent}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Visibility="{Binding UndoStatus, Converter={StaticResource EmptyToCollapsed}}" />
                    <TextBlock Style="{StaticResource Sub}" Text="Ordenar nunca borra: solo mueve los archivos sueltos a carpetas por tipo. Si no te gusta, «Deshacer» los devuelve a su sitio (o dime «deshazlo»)." />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</Window>
