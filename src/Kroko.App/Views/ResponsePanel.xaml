<Window x:Class="Kroko.App.Views.ResponsePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Kroko.App.Views"
        Title="Kroko"
        Width="372"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Kroko.Font}"
        Foreground="{StaticResource Kroko.Text}">

    <Window.Resources>
        <v:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
        <v:BoolToVisibleConverter x:Key="BoolToVisibility" />
        <v:ProgressToDashConverter x:Key="ProgressToDash" />
        <v:LevelToScaleConverter x:Key="LevelToScale" />
        <v:NotNullToVisibleConverter x:Key="NotNullToVisible" />

        <!-- Vidrio oscuro: degradado casi negro con un toque más claro arriba -->
        <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F21A1A1A" Offset="0" />
            <GradientStop Color="#F0111111" Offset="0.45" />
            <GradientStop Color="#EE0C0C0C" Offset="1" />
        </LinearGradientBrush>
        <!-- Borde con brillo arriba (luz que cae sobre el vidrio) -->
        <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3DF5F1E9" Offset="0" />
            <GradientStop Color="#14F5F1E9" Offset="0.35" />
            <GradientStop Color="#0DF5F1E9" Offset="1" />
        </LinearGradientBrush>

        <!-- Una barra de la onda de voz -->
        <Style x:Key="WaveBar" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Margin" Value="1.5,0" />
            <Setter Property="Background" Value="{StaticResource Kroko.Accent}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- Margen transparente alrededor para la sombra -->
    <Grid Margin="10">
        <Border x:Name="Card" CornerRadius="18" Background="{StaticResource Glass}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1"
                RenderTransformOrigin="1,1">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.55" RenderingBias="Performance" />
            </Border.Effect>

            <Grid>
                <!-- Reflejo del vidrio -->
                <Border CornerRadius="17,17,40,40" Height="46" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- Resplandor lima mientras te escucha -->
                <Border CornerRadius="17" IsHitTestVisible="False" BorderThickness="1" BorderBrush="{StaticResource Kroko.Accent}" Opacity="0.55"
                        Visibility="{Binding IsListening, Converter={StaticResource BoolToVisibility}}">
                    <Border.Effect>
                        <BlurEffect Radius="6" />
                    </Border.Effect>
                </Border>

                <StackPanel Margin="16,14,16,11">

                    <!-- Escuchando: onda de voz + indicación -->
                    <DockPanel Margin="0,0,0,8" Visibility="{Binding IsListening, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Height="22" Margin="0,0,10,0">
                            <Border Style="{StaticResource WaveBar}">
                                <Border.RenderTransform><ScaleTransform ScaleY="{Binding MicLevel, Converter={StaticResource LevelToScale}, ConverterParameter=0.7}" /></Border.RenderTransform>
                            </Border>
                            <Border Style="{StaticResource WaveBar}">
                                <Border.RenderTransform><ScaleTransform ScaleY="{Binding MicLevel, Converter={StaticResource LevelToScale}, ConverterParameter=1.3}" /></Border.RenderTransform>
                            </Border>
                            <Border Style="{StaticResource WaveBar}">
                                <Border.RenderTransform><ScaleTransform ScaleY="{Binding MicLevel, Converter={StaticResource LevelToScale}, ConverterParameter=1.8}" /></Border.RenderTransform>
                            </Border>
                            <Border Style="{StaticResource WaveBar}">
                                <Border.RenderTransform><ScaleTransform ScaleY="{Binding MicLevel, Converter={StaticResource LevelToScale}, ConverterParameter=1.2}" /></Border.RenderTransform>
                            </Border>
                            <Border Style="{StaticResource WaveBar}">
                                <Border.RenderTransform><ScaleTransform ScaleY="{Binding MicLevel, Converter={StaticResource LevelToScale}, ConverterParameter=0.6}" /></Border.RenderTransform>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ListeningHint}" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource Kroko.Accent}" />
                    </DockPanel>

                    <!-- Lo que dijiste (subtítulos en vivo mientras hablas; luego lo que entendió el cerebro) -->
                    <TextBlock Text="{Binding UserText}" TextWrapping="Wrap" Margin="0,0,0,8" MaxHeight="64" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding UserText, Converter={StaticResource EmptyToCollapsed}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12.5" />
                                <Setter Property="Foreground" Value="{StaticResource Kroko.TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListening}" Value="True">
                                        <Setter Property="FontSize" Value="14.5" />
                                        <Setter Property="Foreground" Value="{StaticResource Kroko.Text}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Pensando… -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                Visibility="{Binding IsThinking, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Pensando" FontSize="13" Foreground="{StaticResource Kroko.TextMuted}" />
                        <TextBlock x:Name="Dot1" Text="." FontSize="13" Foreground="{StaticResource Kroko.Accent}" />
                        <TextBlock x:Name="Dot2" Text="." FontSize="13" Foreground="{StaticResource Kroko.Accent}" />
                        <TextBlock x:Name="Dot3" Text="." FontSize="13" Foreground="{StaticResource Kroko.Accent}" />
                        <StackPanel.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.4" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.4" BeginTime="0:0:0.15" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.4" BeginTime="0:0:0.3" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </StackPanel.Triggers>
                    </StackPanel>

                    <!-- Respuesta de Kroko (blanco, o ámbar si es un aviso) -->
                    <ScrollViewer x:Name="ReplyScroll" MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding ReplyText, Converter={StaticResource EmptyToCollapsed}}"
                                  Margin="0,0,0,10">
                        <TextBlock Text="{Binding ReplyText}" TextWrapping="Wrap" FontSize="14.5" LineHeight="21">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Kroko.Text}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReplyError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Kroko.EyeAlert}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ScrollViewer>

                    <!-- Tarjeta: lista con checks o estado del equipo con barras -->
                    <Border CornerRadius="12" Padding="12,10,12,6" Margin="0,0,0,10" Background="#B31A1A1A"
                            BorderBrush="{StaticResource Kroko.Line}" BorderThickness="1"
                            Visibility="{Binding HasCard, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding CardTitle}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Kroko.Accent}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding CardItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <DockPanel>
                                                <!-- Check (listas y "internet") -->
                                                <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,9,0" VerticalAlignment="Top"
                                                      Visibility="{Binding Done, Converter={StaticResource NotNullToVisible}}">
                                                    <Ellipse x:Name="CheckBg" Stroke="{StaticResource Kroko.TextMuted}" StrokeThickness="1.4" />
                                                    <Path x:Name="CheckMark" Data="M 5,9.5 L 8,12.5 L 13.5,6.5" Stroke="{StaticResource Kroko.OnAccent}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                                                </Grid>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="11.5" Margin="8,1,0,0"
                                                           Foreground="{StaticResource Kroko.TextMuted}" />
                                                <TextBlock x:Name="ItemText" Text="{Binding Text}" FontSize="13" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Kroko.Text}" />
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                            <!-- Barra (estado del equipo) -->
                                            <ProgressBar Style="{StaticResource Kroko.Progress}" Maximum="1" Height="5" Margin="0,5,0,0"
                                                         Value="{Binding Value, TargetNullValue=0}"
                                                         Visibility="{Binding Value, Converter={StaticResource NotNullToVisible}}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Done}" Value="True">
                                                <Setter TargetName="CheckBg" Property="Fill" Value="{StaticResource Kroko.Accent}" />
                                                <Setter TargetName="CheckBg" Property="Stroke" Value="{StaticResource Kroko.Accent}" />
                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="ItemText" Property="Foreground" Value="{StaticResource Kroko.TextMuted}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta del temporizador / pomodoro (cuenta regresiva circular) -->
                    <Border CornerRadius="12" Padding="12,10" Margin="0,0,0,10" Background="#B31A1A1A"
                            BorderBrush="{StaticResource Kroko.Line}" BorderThickness="1"
                            Visibility="{Binding Timers.IsActive, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Grid Width="40" Height="40" DockPanel.Dock="Left" Margin="0,0,12,0">
                                <Ellipse Stroke="{StaticResource Kroko.Line}" StrokeThickness="4" />
                                <Ellipse Stroke="{StaticResource Kroko.Accent}" StrokeThickness="4" StrokeDashCap="Round"
                                         StrokeDashArray="{Binding Timers.Progress, Converter={StaticResource ProgressToDash}, ConverterParameter='40,4'}"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <Button DockPanel.Dock="Right" Content="Cancelar" Command="{Binding CancelTimerCommand}"
                                    Style="{StaticResource Kroko.Button}" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Timers.RemainingText}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                                <TextBlock Text="{Binding Timers.Label}" FontSize="11.5" Foreground="{StaticResource Kroko.TextMuted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Tarjeta de confirmación (acciones peligrosas) -->
                    <Border CornerRadius="12" Padding="12,10" Margin="0,0,0,10" BorderThickness="1"
                            Background="#1FFFB547" BorderBrush="{StaticResource Kroko.EyeAlert}"
                            Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="¿LO HAGO?" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Kroko.EyeAlert}" />
                            <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,4,0,10" Foreground="{StaticResource Kroko.Text}" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ApproveButton" Content="Sí, hazlo" Command="{Binding ApproveCommand}" IsDefault="True"
                                        Style="{StaticResource Kroko.ConfirmButton}" />
                                <Button Content="Cancelar" Command="{Binding DenyCommand}" Style="{StaticResource Kroko.Button}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding ConfirmVoiceHint}" FontSize="11.5" Margin="0,8,0,0" Foreground="{StaticResource Kroko.Accent}"
                                       Visibility="{Binding ConfirmVoiceHint, Converter={StaticResource EmptyToCollapsed}}" />
                            <TextBlock Text="Enter = sí · Esc = cancelar" FontSize="10.5" Margin="0,8,0,0"
                                       Foreground="{StaticResource Kroko.TextMuted}" Opacity="0.8" />
                        </StackPanel>
                    </Border>

                    <!-- Caja para escribir -->
                    <Border CornerRadius="14" Background="#CC1A1A1A" BorderThickness="1" Padding="12,4,4,4"
                            Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource Kroko.Line}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource Kroko.Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Escríbele a Kroko… o di «Oye Kroko»" VerticalAlignment="Center" FontSize="13.5" Margin="2,0,0,0"
                                       Foreground="{StaticResource Kroko.TextMuted}" Opacity="0.7" IsHitTestVisible="False"
                                       Visibility="{Binding InputText, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" />
                            <TextBox x:Name="Input" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" FontSize="13.5" VerticalAlignment="Center"
                                     Foreground="{StaticResource Kroko.Text}" CaretBrush="{StaticResource Kroko.Accent}"
                                     SelectionBrush="{StaticResource Kroko.Accent}" MaxLength="2000" Padding="0,6"
                                     TextChanged="Input_TextChanged">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <Button Grid.Column="1" Command="{Binding SendCommand}" Width="30" Height="30" Margin="6,0,0,0"
                                    Cursor="Hand" ToolTip="Enviar (Enter)">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse x:Name="Bg" Fill="{StaticResource Kroko.Accent}" />
                                            <Path Data="M 15,21 L 15,9 M 10,14 L 15,9 L 20,14" Stroke="{StaticResource Kroko.OnAccent}"
                                                  StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.3" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Estado: conexión o conversación en curso -->
                    <DockPanel Margin="2,9,2,0">
                        <TextBlock DockPanel.Dock="Right" Text="Esc para cerrar" FontSize="10.5"
                                   Foreground="{StaticResource Kroko.TextMuted}" Opacity="0.7" />
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Kroko.EyeError}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Kroko.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="10.5" Foreground="{StaticResource Kroko.TextMuted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding StatusText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConversation}" Value="True">
                                            <Setter Property="Text" Value="En conversación · di «gracias» para terminar" />
                                            <Setter Property="Foreground" Value="{StaticResource Kroko.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
