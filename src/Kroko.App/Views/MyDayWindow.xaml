<Window x:Class="Kroko.App.Views.MyDayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Kroko.App.Views"
        Title="Kroko — Mi día"
        Width="820" Height="640" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Kroko.Window}"
        Foreground="{StaticResource Kroko.Text}"
        FontFamily="{StaticResource Kroko.Font}"
        FontSize="13">

    <Window.Resources>
        <v:BoolToVisibleConverter x:Key="BoolToVisible" />
        <v:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
        <v:NotNullToVisibleConverter x:Key="NotNullToVisible" />
        <v:ZeroToVisibleConverter x:Key="ZeroToVisible" />

        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Kroko.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Kroko.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Empty" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Kroko.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Kroko.Icons}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,1,10,0" />
            <Setter Property="Foreground" Value="{StaticResource Kroko.Accent}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="28,24,28,20">
        <!-- Encabezado: fecha, saludo y clima -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <Border DockPanel.Dock="Right" Style="{StaticResource Section}" Margin="0" Padding="18,12" MinWidth="220"
                    Visibility="{Binding Clima, Converter={StaticResource NotNullToVisible}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Clima.TempText}" FontSize="36" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Clima.Descripcion}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Clima.RangeText}" Style="{StaticResource Empty}" />
                        <TextBlock Style="{StaticResource Empty}">
                            <Run Text="{Binding Clima.Ciudad, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Clima.RainText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Fecha}" Style="{StaticResource Kroko.Label}" Margin="0" />
                <TextBlock Text="{Binding Saludo}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Pie: avisos + actualizar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Content="Actualizar" Style="{StaticResource Kroko.Button}" Margin="0" Command="{Binding LoadCommand}" />
            <ItemsControl ItemsSource="{Binding Avisos}" VerticalAlignment="Center">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource Empty}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Izquierda: agenda y recordatorios -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" Style="{StaticResource Icon}" /><TextBlock Text="Agenda" Style="{StaticResource SectionTitle}" /></StackPanel>
                            <TextBlock Text="Nada en tu calendario hoy." Style="{StaticResource Empty}"
                                       Visibility="{Binding Agenda.Count, Converter={StaticResource ZeroToVisible}}" />
                            <ItemsControl ItemsSource="{Binding Agenda}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Hora}" Width="100" FontFamily="Consolas"
                                                       Foreground="{StaticResource Kroko.Accent}" Margin="0,1,0,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Titulo}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Lugar}" Style="{StaticResource Empty}" TextWrapping="Wrap"
                                                           Visibility="{Binding Lugar, Converter={StaticResource EmptyToCollapsed}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA8F;" Style="{StaticResource Icon}" /><TextBlock Text="Recordatorios de hoy" Style="{StaticResource SectionTitle}" /></StackPanel>
                            <TextBlock Text="Ningún recordatorio para hoy." Style="{StaticResource Empty}"
                                       Visibility="{Binding Recordatorios.Count, Converter={StaticResource ZeroToVisible}}" />
                            <ItemsControl ItemsSource="{Binding Recordatorios}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Hora}" Width="78" FontFamily="Consolas" Foreground="{StaticResource Kroko.Accent}" />
                                            <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Derecha: tareas y hábitos -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D5;" Style="{StaticResource Icon}" /><TextBlock Text="Pendientes" Style="{StaticResource SectionTitle}" /></StackPanel>
                            <TextBlock Text="¡Nada pendiente para hoy!" Style="{StaticResource Empty}"
                                       Visibility="{Binding Tareas.Count, Converter={StaticResource ZeroToVisible}}" />
                            <ItemsControl ItemsSource="{Binding Tareas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,9">
                                            <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="8" Height="8" Margin="2,6,12,0" VerticalAlignment="Top"
                                                     Fill="{StaticResource Kroko.Accent}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="Meta" Text="{Binding Meta}" Style="{StaticResource Empty}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Vencida}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Kroko.EyeError}" />
                                                <Setter TargetName="Meta" Property="Foreground" Value="{StaticResource Kroko.EyeError}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" Style="{StaticResource Icon}" /><TextBlock Text="Hábitos" Style="{StaticResource SectionTitle}" /></StackPanel>
                            <TextBlock Text="Aún no tienes hábitos. Dime «quiero tomar 2 litros de agua al día»." Style="{StaticResource Empty}" TextWrapping="Wrap"
                                       Visibility="{Binding Habitos.Count, Converter={StaticResource ZeroToVisible}}" />
                            <ItemsControl ItemsSource="{Binding Habitos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,8">
                                            <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,10,0">
                                                <Ellipse x:Name="Bg" Stroke="{StaticResource Kroko.TextMuted}" StrokeThickness="1.4" />
                                                <Path x:Name="Mark" Data="M 5,9.5 L 8,12.5 L 13.5,6.5" Stroke="{StaticResource Kroko.OnAccent}" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                                            </Grid>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Meta}" Style="{StaticResource Empty}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Hecho}" Value="True">
                                                <Setter TargetName="Bg" Property="Fill" Value="{StaticResource Kroko.Accent}" />
                                                <Setter TargetName="Bg" Property="Stroke" Value="{StaticResource Kroko.Accent}" />
                                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
