<Window x:Class="Kroko.App.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Kroko.App.Views"
        xmlns:face="clr-namespace:Kroko.App.Face"
        Title="Configurar Kroko"
        Width="880" Height="700" MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Kroko.Window}"
        Foreground="{StaticResource Kroko.Text}"
        FontFamily="{StaticResource Kroko.Font}"
        FontSize="13">

    <Window.Resources>
        <v:BoolToVisibleConverter x:Key="BoolToVisible" />
        <v:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />

        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource Kroko.Field}">
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style x:Key="Secret" TargetType="PasswordBox" BasedOn="{StaticResource Kroko.Secret}">
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Kroko.TextMuted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Kroko.Accent}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" TextDecorations="Underline" Margin="0,0,0,8" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="Foreground" Value="{StaticResource Kroko.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Desplegable oscuro (el de Windows sale blanco) -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Kroko.Text}" />
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{StaticResource Kroko.Surface}" BorderBrush="{StaticResource Kroko.Line}"
                                                BorderThickness="1" CornerRadius="6">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Kroko.TextMuted}" StrokeThickness="1.5" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Kroko.Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="10,0,30,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource Kroko.Surface}" BorderBrush="{StaticResource Kroko.Line}" BorderThickness="1"
                                        CornerRadius="6" Margin="0,2,0,0" MaxHeight="280"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource Kroko.Text}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Padding="10,6" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Kroko.SurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Kroko.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Page" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Riel izquierdo: Kroko en vivo + pasos -->
        <Border Grid.Column="0" Background="{StaticResource Kroko.Surface}" BorderBrush="{StaticResource Kroko.Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="22,26,18,22">
                <Border DockPanel.Dock="Top" Width="132" Height="132" CornerRadius="66" Background="{StaticResource Kroko.Body}"
                        BorderBrush="{StaticResource Kroko.BodyEdge}" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,22">
                    <face:FaceView Animator="{Binding Face}" Margin="6" />
                </Border>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0"
                           Text="Puedes volver aquí cuando quieras: clic derecho en Kroko → Configurar Kroko." />
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Grid Width="22" Height="22" Margin="0,0,10,0">
                                    <Ellipse x:Name="Dot" Stroke="{StaticResource Kroko.Line}" StrokeThickness="1.5" Fill="Transparent" />
                                    <TextBlock x:Name="Check" Text="✓" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{StaticResource Kroko.OnAccent}" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="Label" Text="{Binding Title}" VerticalAlignment="Center"
                                           Foreground="{StaticResource Kroko.TextMuted}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Kroko.Accent}" />
                                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Kroko.Accent}" />
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Kroko.Accent}" />
                                    <Setter TargetName="Dot" Property="Fill" Value="Transparent" />
                                    <Setter TargetName="Check" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Kroko.Text}" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Contenido del paso -->
        <DockPanel Grid.Column="1" Margin="34,28,30,22">

            <!-- Botones -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Más tarde" Style="{StaticResource Kroko.Button}" Margin="0"
                        Command="{Binding LaterCommand}"
                        Visibility="{Binding IsDone, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}" />
                <Button DockPanel.Dock="Right" Content="{Binding NextText}" Style="{StaticResource Kroko.PrimaryButton}" Margin="0"
                        IsDefault="True" Command="{Binding NextCommand}" />
                <Button DockPanel.Dock="Right" Content="Saltar este paso" Style="{StaticResource Kroko.Button}" Margin="0,0,10,0"
                        Command="{Binding SkipCommand}">
                    <Button.Visibility>
                        <MultiBinding Converter="{x:Static v:AnyTrueToVisibleConverter.Instance}">
                            <Binding Path="IsAi" />
                            <Binding Path="IsMail" />
                            <Binding Path="IsTelegram" />
                            <Binding Path="IsExtras" />
                        </MultiBinding>
                    </Button.Visibility>
                </Button>
                <Button DockPanel.Dock="Right" Content="Atrás" Style="{StaticResource Kroko.Button}" Margin="0,0,10,0"
                        Command="{Binding BackCommand}"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisible}}" />
            </DockPanel>

            <!-- Mensaje del paso -->
            <Border DockPanel.Dock="Bottom" CornerRadius="10" Padding="12,9" Margin="0,10,0,0"
                    Visibility="{Binding Message, Converter={StaticResource EmptyToCollapsed}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1A2A12" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                <Setter Property="Background" Value="#2E1418" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Kroko.Accent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Kroko.EyeError}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- 0 · Bienvenida -->
                    <StackPanel Style="{StaticResource Page}" Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="HOLA" Style="{StaticResource Kroko.Label}" />
                        <TextBlock Text="¡Hola! Soy Kroko." FontSize="28" FontWeight="Bold" Margin="0,4,0,14" />
                        <TextBlock Style="{StaticResource Body}"
                                   Text="Voy a vivir en esta computadora para ayudarte: abro programas, ordeno archivos, busco en internet, reviso tu correo, te recuerdo cosas y te hablo por Telegram cuando no estés." />
                        <TextBlock Style="{StaticResource Body}"
                                   Text="Antes de empezar quiero conocerte y que me des acceso a lo que quieras que use. Toma unos 5 minutos y casi todo es opcional." />
                        <Border Style="{StaticResource Kroko.Card}" Padding="14,12" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="Tu privacidad" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0"
                                           Text="Tus claves se guardan cifradas con tu usuario de Windows y nunca se muestran. Nada irreversible (borrar, apagar, enviar correos, comprar…) ocurre sin que tú lo apruebes. Nunca escribo contraseñas ni datos de tarjeta." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Kroko.Card}" Padding="14,12" Margin="0,10,0,0" BorderBrush="{StaticResource Kroko.EyeAlert}"
                                Visibility="{Binding ShowServerSetup, Converter={StaticResource BoolToVisible}}">
                            <StackPanel>
                                <TextBlock Text="¿Dónde está mi cerebro?" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                           Text="No lo encuentro. Escribe la dirección de tu servidor y su token (el Agent__Token del .env del servidor). Kroko se reiniciará para conectarse." />
                                <TextBlock Text="Dirección del cerebro" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                                <TextBlock Text="Token" Style="{StaticResource FieldLabel}" />
                                <PasswordBox Style="{StaticResource Secret}" v:PasswordBoxAssist.BoundPassword="{Binding ServerToken}" Margin="0,4,0,12" />
                                <Button Content="Guardar y conectar" Style="{StaticResource Kroko.PrimaryButton}" HorizontalAlignment="Left" Margin="0"
                                        Command="{Binding SaveServerCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 1 · Sobre ti -->
                    <StackPanel Style="{StaticResource Page}" Visibility="{Binding IsProfile, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="PASO 1" Style="{StaticResource Kroko.Label}" />
                        <TextBlock Text="¿Quién eres?" FontSize="24" FontWeight="Bold" Margin="0,4,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tu nombre *" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                                <TextBlock Text="Ciudad" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="¿Cómo te llamo?" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CallMe, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                                <TextBlock Text="País" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Zona horaria (para tus recordatorios)" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding TimeZones}" SelectedItem="{Binding SelectedTimeZone}" Style="{StaticResource DarkCombo}" />
                        <TextBlock Text="¿Con qué acento te hablo?" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Accents}" SelectedItem="{Binding Accent}" Style="{StaticResource DarkCombo}"
                                  Width="260" HorizontalAlignment="Left" />
                        <TextBlock Text="Cuéntame algo de ti (opcional)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding About, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="74" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Por ejemplo: a qué te dedicas, tus horarios o cómo te gusta que te ayude. Lo demás lo iré aprendiendo." />
                    </StackPanel>

                    <!-- 2 · Cerebro -->
                    <StackPanel Style="{StaticResource Page}" Visibility="{Binding IsAi, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="PASO 2" Style="{StaticResource Kroko.Label}" />
                        <TextBlock Text="Mi cerebro" FontSize="24" FontWeight="Bold" Margin="0,4,0,8" />
                        <TextBlock Style="{StaticResource Body}" Text="Pienso con inteligencia artificial. Necesito al menos la clave de Gemini (gratis con tu cuenta de Google)." />

                        <TextBlock Text="Clave de Gemini" Style="{StaticResource FieldLabel}" />
                        <PasswordBox Style="{StaticResource Secret}" v:PasswordBoxAssist.BoundPassword="{Binding GeminiKey}" />
                        <TextBlock Text="{Binding GeminiState}" Style="{StaticResource Hint}" Margin="0,0,0,2" />
                        <Button Content="Conseguir mi clave en Google AI Studio" Style="{StaticResource LinkButton}"
                                Command="{Binding OpenLinkCommand}" CommandParameter="https://aistudio.google.com/apikey" />

                        <TextBlock Text="Clave de Tavily (búsqueda web)" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                        <PasswordBox Style="{StaticResource Secret}" v:PasswordBoxAssist.BoundPassword="{Binding TavilyKey}" />
                        <TextBlock Text="{Binding TavilyState}" Style="{StaticResource Hint}" Margin="0,0,0,2" />
                        <Button Content="Crear cuenta gratis en app.tavily.com (1.000 búsquedas al mes)" Style="{StaticResource LinkButton}"
                                Command="{Binding OpenLinkCommand}" CommandParameter="https://app.tavily.com" />

                        <TextBlock Text="Clave de DeepSeek (respaldo)" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                        <PasswordBox Style="{StaticResource Secret}" v:PasswordBoxAssist.BoundPassword="{Binding DeepSeekKey}" />
                        <TextBlock Text="{Binding DeepSeekState}" Style="{StaticResource Hint}" />
                    </StackPanel>

                    <!-- 3 · Correo -->
                    <StackPanel Style="{StaticResource Page}" Visibility="{Binding IsMail, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="PASO 3" Style="{StaticResource Kroko.Label}" />
                        <TextBlock Text="Tu Gmail" FontSize="24" FontWeight="Bold" Margin="0,4,0,8" />
                        <TextBlock Text="{Binding MailState}" Style="{StaticResource Body}" />
                        <Border Style="{StaticResource Kroko.Card}" Padding="14,12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Cómo crear la contraseña de aplicación (2 minutos)" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                           Text="1. Activa la verificación en 2 pasos de tu cuenta de Google (si no la tienes).&#x0a;2. Abre la página de contraseñas de aplicación, escribe «Kroko» y pulsa Crear.&#x0a;3. Copia las 16 letras que te da Google y pégalas aquí abajo. No es tu contraseña normal: la puedes borrar cuando quieras." />
                                <Button Content="Abrir contraseñas de aplicación de Google" Style="{StaticResource LinkButton}" Margin="0"
                                        Command="{Binding OpenLinkCommand}" CommandParameter="https://myaccount.google.com/apppasswords" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Tu correo de Gmail" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding MailAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                        <TextBlock Text="Contraseña de aplicación (16 letras)" Style="{StaticResource FieldLabel}" />
                        <PasswordBox Style="{StaticResource Secret}" v:PasswordBoxAssist.BoundPassword="{Binding MailPassword}" />
                        <Button Content="Guardar y probar" Style="{StaticResource Kroko.Button}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Command="{Binding TestMailCommand}" />
                    </StackPanel>

                    <!-- 4 · Telegram -->
                    <StackPanel Style="{StaticResource Page}" Visibility="{Binding IsTelegram, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="PASO 4" Style="{StaticResource Kroko.Label}" />
                        <TextBlock Text="Háblame desde el móvil" FontSize="24" FontWeight="Bold" Margin="0,4,0,8" />
                        <TextBlock Text="{Binding TelegramState}" Style="{StaticResource Body}" />

                        <StackPanel Visibility="{Binding TelegramLinked, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}">
                            <Border Style="{StaticResource Kroko.Card}" Padding="14,12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="1 · Crea tu bot (una sola vez)" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                               Text="En Telegram abre @BotFather, envíale /newbot, ponle un nombre (por ejemplo «Kroko de Ana») y un usuario que termine en «bot». Te dará un token: cópialo y pégalo aquí." />
                                    <Button Content="Abrir @BotFather" Style="{StaticResource LinkButton}" Margin="0"
                                            Command="{Binding OpenLinkCommand}" CommandParameter="https://t.me/BotFather" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Token del bot" Style="{StaticResource FieldLabel}" />
                            <PasswordBox Style="{StaticResource Secret}" v:PasswordBoxAssist.BoundPassword="{Binding TelegramToken}" />
                            <TextBlock Style="{StaticResource Hint}" Text="Si ya lo pusiste antes, déjalo vacío." />

                            <TextBlock Text="2 · Vincula tu chat" FontWeight="SemiBold" Margin="0,4,0,6" />
                            <Button Content="Vincular mi Telegram" Style="{StaticResource Kroko.Button}" HorizontalAlignment="Left" Margin="0,0,0,10"
                                    Command="{Binding LinkTelegramCommand}" />
                            <Border Style="{StaticResource Kroko.Card}" Padding="14,12"
                                    Visibility="{Binding PairingCode, Converter={StaticResource EmptyToCollapsed}}">
                                <StackPanel>
                                    <TextBlock Text="Tu código" Style="{StaticResource Kroko.Label}" />
                                    <TextBlock Text="{Binding PairingCode}" FontFamily="Consolas" FontSize="30" FontWeight="Bold"
                                               Foreground="{StaticResource Kroko.Accent}" Margin="0,2,0,6" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                               Text="Se abrió Telegram: pulsa «Iniciar». Si no se abrió, escríbele este código a tu bot. Te espero aquí…" />
                                    <Button Content="Abrir el chat con mi bot otra vez" Style="{StaticResource LinkButton}" Margin="0"
                                            Command="{Binding OpenPairingLinkCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- 5 · Tus apps -->
                    <StackPanel Style="{StaticResource Page}" Visibility="{Binding IsExtras, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="PASO 5" Style="{StaticResource Kroko.Label}" />
                        <TextBlock Text="Tus apps" FontSize="24" FontWeight="Bold" Margin="0,4,0,8" />
                        <TextBlock Style="{StaticResource Body}" Text="Conecta donde guardas tus tareas y notas. Así puedo decirte qué tienes pendiente y anotarte cosas. Todo es opcional." />

                        <!-- Notion y Todoist: botón Conectar de la ventana Conectores -->
                        <Border Style="{StaticResource Kroko.Card}" Padding="14,12" Margin="0,0,0,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Conectar" Style="{StaticResource Kroko.Button}" Margin="12,0,0,0"
                                        VerticalAlignment="Center" Command="{Binding OpenConnectorsCommand}" />
                                <StackPanel>
                                    <TextBlock Text="Notion y Todoist" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                               Text="Notas en Notion y tareas en Todoist. Pulsa Conectar en cada uno y luego «Permitir» en el navegador." />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Trello -->
                        <Border Style="{StaticResource Kroko.Card}" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Trello" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TrelloState}" Style="{StaticResource Hint}" Margin="0,4,0,8" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                           Text="1. Abre el panel de Power-Ups, crea uno llamado «Kroko» y copia su clave de API.  2. Pégala abajo y pulsa «Generar token»; acepta y copia el token." />
                                <Button Content="Abrir el panel de Power-Ups de Trello" Style="{StaticResource LinkButton}"
                                        Command="{Binding OpenLinkCommand}" CommandParameter="https://trello.com/power-ups/admin" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Clave de API" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding TrelloKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" FontFamily="Consolas" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Token" Style="{StaticResource FieldLabel}" />
                                        <PasswordBox Style="{StaticResource Secret}" v:PasswordBoxAssist.BoundPassword="{Binding TrelloToken}" Margin="0,4,0,12" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Generar token" Style="{StaticResource Kroko.Button}" Command="{Binding OpenTrelloTokenCommand}" />
                                    <Button Content="Guardar y probar" Style="{StaticResource Kroko.Button}" Command="{Binding SaveTrelloCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Google -->
                        <Border Style="{StaticResource Kroko.Card}" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="Google: Tasks, Calendar, Drive y Contactos" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding GoogleState}" Style="{StaticResource Hint}" Margin="0,4,0,8" />
                                <StackPanel Visibility="{Binding GoogleConnected, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}">
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                               Text="Una sola vez (10 min): 1. En Google Cloud crea un proyecto.  2. En «Biblioteca» activa Google Tasks API, Google Calendar API, Google Drive API y People API (contactos).  3. En «Pantalla de consentimiento» elige Externo y agrégate como usuario de prueba.  4. En «Credenciales» crea un ID de cliente OAuth de tipo «App de escritorio» y copia el ID y el secreto aquí." />
                                    <Button Content="Abrir Google Cloud (credenciales)" Style="{StaticResource LinkButton}"
                                            Command="{Binding OpenLinkCommand}" CommandParameter="https://console.cloud.google.com/apis/credentials" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="ID de cliente" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding GoogleClientId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" FontFamily="Consolas" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Secreto del cliente" Style="{StaticResource FieldLabel}" />
                                            <PasswordBox Style="{StaticResource Secret}" v:PasswordBoxAssist.BoundPassword="{Binding GoogleClientSecret}" Margin="0,4,0,12" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="Conectar mi cuenta de Google" Style="{StaticResource Kroko.Button}" HorizontalAlignment="Left"
                                            Command="{Binding ConnectGoogleCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 6 · Listo -->
                    <StackPanel Style="{StaticResource Page}" Visibility="{Binding IsDone, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="LISTO" Style="{StaticResource Kroko.Label}" />
                        <TextBlock Text="{Binding Greeting}" FontSize="28" FontWeight="Bold" Margin="0,4,0,14" />
                        <ItemsControl ItemsSource="{Binding Summary}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="14" Margin="0,0,0,8" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Body}"
                                   Text="Dime «Oye Kroko» y pídeme lo que necesites: «¿qué tengo pendiente hoy?», «recuérdame tomar agua en 30 minutos» o «cada mañana a las 7 mándame las noticias por Telegram». También puedes pulsar Ctrl+Espacio, y Ctrl+Alt+K me detiene al instante." />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
