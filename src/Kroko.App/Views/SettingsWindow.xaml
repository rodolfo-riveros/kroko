                                        <Button Content="Guardar tope" Command="{Binding SaveDailyLimitCommand}" Style="{StaticResource Btn}" />
                                        <TextBox Text="{Binding DailyLimitThousands, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowField}" Width="110" />
                                        <StackPanel Style="{StaticResource Text}">
                                            <TextBlock Text="Miles de tokens por día" Style="{StaticResource Label}" />
                                            <TextBlock Text="0 = sin tope. Al pasarlo entra en modo ahorro: sin voz en tiempo real ni su voz (el chat sigue)." Style="{StaticResource Sub}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBlock Text="{Binding UsageStatus}" Style="{StaticResource Foot}" Foreground="{StaticResource Kroko.EyeAlert}"
                                           Visibility="{Binding UsageStatus, Converter={StaticResource EmptyToCollapsed}}" />
                                <TextBlock Style="{StaticResource Foot}" Text="Para ver cuánto te cuesta en dinero, compara con Google AI Studio → Usage." />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ============================ 8 · Conexión al cerebro ============================ -->
                    <TabItem>
                        <ScrollViewer>
                            <StackPanel Style="{StaticResource Page}">
                                <TextBlock Text="Dónde piensa Kroko" Style="{StaticResource CardTitle}" Margin="4,2,0,8" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource Row}">
                                            <Button Content="Comprobar" Command="{Binding CheckBrainCommand}" Style="{StaticResource Btn}" />
                                            <StackPanel Style="{StaticResource Text}">
                                                <TextBlock Text="Estado" Style="{StaticResource Label}" />
                                                <TextBlock Text="{Binding BrainStatus}" Style="{StaticResource Sub}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Sep}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <TextBox Text="{Binding BrainUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowField}" />
                                            <StackPanel Style="{StaticResource Text}">
                                                <TextBlock Text="Dirección" Style="{StaticResource Label}" />
                                                <TextBlock Text="Tu dominio (kroko.midominio.com) o localhost:5080 en esta PC." Style="{StaticResource Sub}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Sep}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <PasswordBox Style="{StaticResource RowSecret}" v:PasswordBoxAssist.AllowFill="True" v:PasswordBoxAssist.BoundPassword="{Binding BrainToken}" />
                                            <StackPanel Style="{StaticResource Text}">
                                                <TextBlock Text="Token" Style="{StaticResource Label}" />
                                                <TextBlock Text="El de tu servidor (Agent__Token)." Style="{StaticResource Sub}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Sep}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox IsChecked="{Binding LaunchLocalBrain}" Style="{StaticResource Toggle}" />
                                            <StackPanel Style="{StaticResource Text}">
                                                <TextBlock Text="Cerebro en esta PC" Style="{StaticResource Label}" />
                                                <TextBlock Text="Solo para desarrollo. Apágalo si usas tu servidor." Style="{StaticResource Sub}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Foot}" Text="Pulsa Comprobar para probar lo escrito antes de reiniciar." />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ============================ 9 · Permisos ============================ -->
                    <TabItem>
                        <ScrollViewer>
                            <StackPanel Style="{StaticResource Page}">
                                <TextBlock Text="Lo que puede hacer en tu PC" Style="{StaticResource CardTitle}" Margin="4,2,0,8" />
                                <Border Style="{StaticResource Card}" Padding="0,4">
                                    <ItemsControl ItemsSource="{Binding Tools}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <DockPanel Style="{StaticResource Row}" MinHeight="40">
                                                        <CheckBox IsChecked="{Binding Enabled}" Style="{StaticResource Toggle}" />
                                                        <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Margin="12,0,12,0" VerticalAlignment="Center" Background="#3A3A3C">
                                                            <TextBlock Text="{Binding Risk}" FontSize="10.5" Foreground="{StaticResource Mac.Muted}" />
                                                        </Border>
                                                        <StackPanel Style="{StaticResource Text}" Margin="0,6,0,6">
                                                            <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12.5" />
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Sub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <Border Style="{StaticResource Sep}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <TextBlock Style="{StaticResource Foot}" Text="Lo peligroso (apagar, borrar, enviar…) siempre pide tu confirmación aunque esté encendido." />

                                <TextBlock Text="Buscar en tus documentos" Style="{StaticResource CardTitle}" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox IsChecked="{Binding DocumentsEnabled}" Style="{StaticResource Toggle}" />
                                            <StackPanel Style="{StaticResource Text}"><TextBlock Text="Buscar por significado en Word, PDF y textos" Style="{StaticResource Label}" /><TextBlock Text="{Binding DocumentsStatus}" Style="{StaticResource Sub}" /></StackPanel>
                                        </DockPanel>
                                        <StackPanel Margin="14,0,14,12" IsEnabled="{Binding DocumentsEnabled}">
                                            <TextBlock Text="Carpetas, una por línea. El texto de esos documentos se envía a Gemini para buscar por significado." Style="{StaticResource Sub}" Margin="0,0,0,6" />
                                            <TextBox Text="{Binding DocumentFoldersText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AcceptsReturn="True" Height="64"
                                                     FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Atajos para abrir programas" Style="{StaticResource CardTitle}" />
                                <Border Style="{StaticResource Card}" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="Uno por línea: nombre = ruta o comando. Ej.: ventas = C:\Datos\ventas.xlsx" Style="{StaticResource Sub}" Margin="0,0,0,8" />
                                        <TextBox Text="{Binding AliasesText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AcceptsReturn="True" Height="86"
                                                 FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Scripts permitidos" Style="{StaticResource CardTitle}" />
                                <Border Style="{StaticResource Card}" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="Solo puede ejecutar estos (nombre = ruta a .ps1, .bat, .cmd o .exe), y siempre pregunta antes." Style="{StaticResource Sub}" Margin="0,0,0,8" />
                                        <TextBox Text="{Binding ScriptsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AcceptsReturn="True" Height="86"
                                                 FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ============================ 10 · Privacidad y datos ============================ -->
                    <TabItem>
                        <ScrollViewer>
                            <StackPanel Style="{StaticResource Page}">
                                <TextBlock Text="Tus datos" Style="{StaticResource CardTitle}" Margin="4,2,0,8" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource Row}">
                                            <Button Content="Abrir" Command="{Binding OpenMemoryCommand}" Style="{StaticResource Btn}" />
                                            <StackPanel Style="{StaticResource Text}"><TextBlock Text="Lo que sabe de ti" Style="{StaticResource Label}" /><TextBlock Text="Recuerdos, rutinas, buzón de mejoras y la conversación. Puedes borrar lo que quieras." Style="{StaticResource Sub}" /></StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Sep}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <Button Content="Abrir" Command="{Binding OpenAuditCommand}" Style="{StaticResource Btn}" />
                                            <StackPanel Style="{StaticResource Text}"><TextBlock Text="Registro de acciones" Style="{StaticResource Label}" /><TextBlock Text="Todo lo que hizo en tu PC, con fecha y resultado." Style="{StaticResource Sub}" /></StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Foot}"
                                           Text="Lo que lee en pantallas, páginas o correos es información, no órdenes. Nunca escribe contraseñas ni datos de tarjetas." />

                                <TextBlock Text="Más" Style="{StaticResource CardTitle}" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource Row}">
                                            <Button Content="Abrir" Command="{Binding OpenOnboardingCommand}" Style="{StaticResource Btn}" />
                                            <StackPanel Style="{StaticResource Text}"><TextBlock Text="Asistente de bienvenida" Style="{StaticResource Label}" /><TextBlock Text="Configurar todo paso a paso, como la primera vez." Style="{StaticResource Sub}" /></StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Sep}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <Button Content="Abrir" Command="{Binding OpenGalleryCommand}" Style="{StaticResource Btn}" />
                                            <StackPanel Style="{StaticResource Text}"><TextBlock Text="Galería de expresiones" Style="{StaticResource Label}" /><TextBlock Text="Todas sus caras." Style="{StaticResource Sub}" /></StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </Border>
</Window>
