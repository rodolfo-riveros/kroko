<Window x:Class="Kroko.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Kroko.App.Views"
        Title="Configuración de Kroko"
        Width="980" Height="700" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent" ResizeMode="CanResize"
        v:Glass.Enabled="True"
        Foreground="{StaticResource Kroko.Text}"
        FontFamily="{StaticResource Kroko.Font}"
        FontSize="13">

    <!--
        Configuración estilo macOS (pedido por Pol, 17/11/2026): una sola ventana, barra lateral con iconos de colores
        agrupados en orden de uso (Kroko → Tú → Inteligencia → Seguridad), tarjetas con filas y todo se guarda solo.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <v:BoolToVisibleConverter x:Key="BoolToVisible" />
        <v:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />

        <SolidColorBrush x:Key="Mac.Window" Color="Transparent" />
        <SolidColorBrush x:Key="Mac.Sidebar" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="Mac.Card" Color="#17FFFFFF" />
        <SolidColorBrush x:Key="Mac.Line" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="Mac.Muted" Color="#CDCDD2" />

        <!-- Tarjeta agrupada (inset grouped) -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Mac.Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Kroko.GlassEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <!-- Título de grupo encima de la tarjeta -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="4,18,0,8" />
        </Style>
        <!-- Nota al pie de una tarjeta -->
        <Style x:Key="Foot" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Mac.Muted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="4,0,4,4" />
        </Style>
        <!-- Fila: texto a la izquierda, control a la derecha; línea fina arriba (salvo la primera) -->
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="14,0" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource Mac.Line}" />
            <Setter Property="Margin" Value="14,0,0,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Mac.Muted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Text" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,9,16,9" />
        </Style>
        <Style x:Key="Right" TargetType="FrameworkElement">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Toggle" TargetType="CheckBox" BasedOn="{StaticResource Kroko.Toggle}">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource Kroko.Button}">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource Kroko.Field}">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Campo dentro de una fila (ancho fijo a la derecha) -->
        <Style x:Key="RowField" TargetType="TextBox" BasedOn="{StaticResource Kroko.Field}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="300" />
        </Style>
        <Style x:Key="RowSecret" TargetType="PasswordBox" BasedOn="{StaticResource Kroko.Secret}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="300" />
        </Style>
        <Style x:Key="Page" TargetType="StackPanel">
            <Setter Property="Margin" Value="28,4,28,28" />
            <Setter Property="MaxWidth" Value="720" />
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <!-- Botoncitos rojo, amarillo y verde de macOS -->
        <Style x:Key="Light" TargetType="Button">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="#30000000" StrokeThickness="0.5" />
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontSize="9" FontWeight="Bold"
                                       Foreground="#99000000" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-1,0,0" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Entrada de la barra lateral: cuadrito de color con icono + nombre; grupo encima si lo tiene -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel>
                            <TextBlock Text="{Binding Group}" Foreground="{StaticResource Mac.Muted}" FontSize="11" FontWeight="SemiBold"
                                       Margin="10,14,0,4" Visibility="{Binding Group, Converter={StaticResource EmptyToCollapsed}}" />
                            <Border x:Name="Bd" CornerRadius="6" Padding="8,5" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="{Binding Color}">
                                        <TextBlock Text="{Binding GlyphText}" FontFamily="{StaticResource Kroko.Icons}" FontSize="12.5"
                                                   Foreground="{Binding GlyphColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="Title" Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Kroko.Accent}" />
                                <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Kroko.OnAccent}" />
                                <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Kroko.GlassTint}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================ barra lateral ============================ -->
            <Border Background="{StaticResource Mac.Sidebar}" CornerRadius="16" BorderBrush="{StaticResource Kroko.GlassEdge}" BorderThickness="1" Margin="8,8,0,8">
                <DockPanel Margin="10,0,10,12">
                    <!-- Semáforo + zona para arrastrar la ventana -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="46" Margin="6,0,0,0"
                                Background="Transparent" MouseLeftButtonDown="Drag_MouseLeftButtonDown">
                        <Button Style="{StaticResource Light}" Background="#FF5F57" Content="×" Click="Close_Click" ToolTip="Cerrar" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Light}" Background="#FEBC2E" Content="–" Click="Minimize_Click" ToolTip="Minimizar" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Light}" Background="#28C840" Content="+" Click="Maximize_Click" ToolTip="Agrandar" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Buscar -->
                    <Border DockPanel.Dock="Top" CornerRadius="9" Background="#1FFFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Margin="4,0,4,12" Height="30">
                        <DockPanel Margin="8,0">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="{StaticResource Kroko.Icons}" FontSize="12"
                                       Foreground="{StaticResource Mac.Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Grid>
                                <TextBlock Text="Buscar" Foreground="#77777C" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding SearchText, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" />
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource Kroko.Text}" CaretBrush="{StaticResource Kroko.Accent}" VerticalAlignment="Center" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Tu perfil (como la cuenta en macOS): lleva a «Tu perfil» -->
                    <Button DockPanel.Dock="Top" Click="Profile_Click" Cursor="Hand" Margin="0,0,0,6" Foreground="{StaticResource Kroko.Text}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Padding="8,8" Background="Transparent">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="38" Height="30">
                                            <Path Data="M11.5,1 H26.5 Q30.5,1 32,5 L36.6,22 Q38,29 31,29 H7 Q0,29 1.4,22 L6,5 Q7.5,1 11.5,1 Z"
                                                  Fill="{StaticResource Kroko.Body}" Stroke="#4A4A4C" StrokeThickness="1" />
                                            <Border Width="7" Height="2.4" CornerRadius="1.2" Background="{StaticResource Kroko.Accent}" VerticalAlignment="Top" Margin="0,3.4,0,0" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                                                <Border Width="6" Height="8" CornerRadius="2.5" Background="White" Margin="0,0,5,0" />
                                                <Border Width="6" Height="8" CornerRadius="2.5" Background="White" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" MaxWidth="160">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Account.Name}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Account.Name}" Value="">
                                                                <Setter Property="Text" Value="Tu perfil" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="Perfil, claves y cuentas" FontSize="11" Foreground="{StaticResource Mac.Muted}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}" ItemContainerStyle="{StaticResource NavItem}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </Border>

            <!-- ============================ contenido ============================ -->
            <DockPanel Grid.Column="1">
                <!-- Barra de título: nombre de la página (arrastrable) -->
                <Border DockPanel.Dock="Top" Height="52" Background="Transparent" MouseLeftButtonDown="Drag_MouseLeftButtonDown">
                    <TextBlock Text="{Binding PageTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="28,0,0,0" />
                </Border>

                <!-- Aviso de reinicio y problemas al guardar (abajo) -->
                <Border DockPanel.Dock="Bottom" Background="#1AFFFFFF" BorderBrush="{StaticResource Mac.Line}" BorderThickness="0,1,0,0" Padding="28,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NeedsRestart}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Reiniciar Kroko ahora" Command="{Binding RestartCommand}" Style="{StaticResource Kroko.PrimaryButton}" Margin="12,0,0,0" />
                        <TextBlock Text="Guardado. Algunos cambios se notan al reiniciar Kroko." VerticalAlignment="Center" Foreground="{StaticResource Mac.Muted}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding SaveStatus}" Foreground="{StaticResource Kroko.EyeAlert}" TextWrapping="Wrap"
                           Margin="28,0,28,8" Visibility="{Binding SaveStatus, Converter={StaticResource EmptyToCollapsed}}" />

                <TabControl SelectedIndex="{Binding SelectedSection}" Background="Transparent" BorderThickness="0" Padding="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <!-- El contenido de cada página hereda las letras de su pestaña: blancas, no el negro de Windows -->
                            <Setter Property="Foreground" Value="{StaticResource Kroko.Text}" />
                        </Style>
                    </TabControl.ItemContainerStyle>
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </ControlTemplate>
                    </TabControl.Template>

                    <!-- ============================ 0 · General ============================ -->
                    <TabItem>
                        <ScrollViewer>
                            <StackPanel Style="{StaticResource Page}">
                                <TextBlock Text="Dónde vive Kroko" Style="{StaticResource CardTitle}" Margin="4,2,0,8" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox IsChecked="{Binding IslandLook}" Style="{StaticResource Toggle}" />
                                            <StackPanel Style="{StaticResource Text}">
                                                <TextBlock Text="En la isla de arriba" Style="{StaticResource Label}" />
                                                <TextBlock Text="Arriba al centro de la pantalla; con un clic se despliega su panel. Apagado: la burbuja de la esquina." Style="{StaticResource Sub}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Sep}" />
                                        <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding IslandLook}">
                                            <CheckBox IsChecked="{Binding IslandAutoHide}" Style="{StaticResource Toggle}" />
                                            <StackPanel Style="{StaticResource Text}">
                                                <TextBlock Text="Esconder la isla cuando no la uso" Style="{StaticResource Label}" />
                                                <TextBlock Text="Sale al decir «Oye Kroko», cuando hace algo o al pasar el cursor por el borde de arriba, y se va sola al terminar." Style="{StaticResource Sub}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Sep}" />
                                        <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding BubbleOptionsEnabled}">
                                            <StackPanel Style="{StaticResource Right}" Orientation="Horizontal">
                                                <Slider Minimum="0.75" Maximum="1.5" Value="{Binding BubbleScale}" Width="170" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding BubbleScale, StringFormat={}{0:0.00}×}" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Text}">
                                                <TextBlock Text="Tamaño de la burbuja" Style="{StaticResource Label}" />
                                                <TextBlock Text="Solo cuando vive en la esquina." Style="{StaticResource Sub}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Cuándo aparece" Style="{StaticResource CardTitle}" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox IsChecked="{Binding StartWithWindowsEnabled}" Style="{StaticResource Toggle}" />
                                            <StackPanel Style="{StaticResource Text}"><TextBlock Text="Abrir al iniciar Windows" Style="{StaticResource Label}" /></StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Sep}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox IsChecked="{Binding StartHidden}" Style="{StaticResource Toggle}" />
                                            <StackPanel Style="{StaticResource Text}">
                                                <TextBlock Text="Empezar dormido" Style="{StaticResource Label}" />
                                                <TextBlock Text="Despierta con «Oye Kroko», con Ctrl+Espacio o cuando tiene un aviso." Style="{StaticResource Sub}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Sep}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox IsChecked="{Binding HideAfterIdle}" Style="{StaticResource Toggle}" />
                                            <StackPanel Style="{StaticResource Text}">
                                                <TextBlock Text="Descansar al minuto sin uso" Style="{StaticResource Label}" />
                                                <TextBlock Text="En la isla se queda chiquito y dormido; la burbuja se esconde." Style="{StaticResource Sub}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Sep}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox IsChecked="{Binding HideOnFullscreen}" Style="{StaticResource Toggle}" />
                                            <StackPanel Style="{StaticResource Text}">
                                                <TextBlock Text="Esconderse en pantalla completa" Style="{StaticResource Label}" />
                                                <TextBlock Text="Juegos, películas y presentaciones." Style="{StaticResource Sub}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Sonidos" Style="{StaticResource CardTitle}" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox IsChecked="{Binding SoundsEnabled}" Style="{StaticResource Toggle}" />
                                            <StackPanel Style="{StaticResource Text}"><TextBlock Text="Sonidos de Kroko" Style="{StaticResource Label}" /><TextBlock Text="Al escuchar, al terminar y al confirmar." Style="{StaticResource Sub}" /></StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Sep}" />
                                        <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding SoundsEnabled}">
                                            <StackPanel Style="{StaticResource Right}" Orientation="Horizontal">
                                                <Slider Minimum="0" Maximum="1" Value="{Binding SoundVolume}" Width="170" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SoundVolume, StringFormat={}{0:P0}}" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Text}"><TextBlock Text="Volumen" Style="{StaticResource Label}" /></StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ============================ 1 · Voz ============================ -->
                    <TabItem>
                        <ScrollViewer>
                            <StackPanel Style="{StaticResource Page}">
                                <TextBlock Text="«Oye Kroko»" Style="{StaticResource CardTitle}" Margin="4,2,0,8" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox IsChecked="{Binding WakeWordEnabled}" Style="{StaticResource Toggle}" />
                                            <StackPanel Style="{StaticResource Text}">
                                                <TextBlock Text="Despertar con «Oye Kroko»" Style="{StaticResource Label}" />
                                                <TextBlock Text="{Binding ModelStatus}" Style="{StaticResource Sub}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel Margin="14,0,14,12" Visibility="{Binding ModelInstalled, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}">
                                            <ProgressBar Style="{StaticResource Kroko.Progress}" Maximum="1" Value="{Binding DownloadProgress}" Margin="0,0,0,10"
                                                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisible}}" />
                                            <Button HorizontalAlignment="Left" Command="{Binding DownloadModelCommand}" Margin="0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Kroko.Button}">
                                                        <Setter Property="Content" Value="Descargar el oído de Kroko (40 MB)" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True"><Setter Property="Content" Value="Cancelar descarga" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                        <Border Style="{StaticResource Sep}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox IsChecked="{Binding ListenInFullscreen}" Style="{StaticResource Toggle}" />
                                            <StackPanel Style="{StaticResource Text}">
                                                <TextBlock Text="Escuchar también en pantalla completa" Style="{StaticResource Label}" />
                                                <TextBlock Text="Apágalo si juegas con chat de voz." Style="{StaticResource Sub}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Cómo te responde" Style="{StaticResource CardTitle}" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox IsChecked="{Binding RepliesWithVoice}" Style="{StaticResource Toggle}" />
                                            <StackPanel Style="{StaticResource Text}">
                                                <TextBlock Text="Responder con voz" Style="{StaticResource Label}" />
                                                <TextBlock Text="Apagado: solo por escrito. También puedes decirle «no me hables con voz» o «háblame otra vez»." Style="{StaticResource Sub}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Sep}" />
                                        <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding RepliesWithVoice}">
                                            <CheckBox IsChecked="{Binding SpeakTypedReplies}" Style="{StaticResource Toggle}" />
                                            <StackPanel Style="{StaticResource Text}"><TextBlock Text="Hablar también lo que te responde por escrito" Style="{StaticResource Label}" /></StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Sep}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox IsChecked="{Binding LocalTtsFallback}" Style="{StaticResource Toggle}" />
                                            <StackPanel Style="{StaticResource Text}">
                                                <TextBlock Text="Voz de Windows si falla la suya" Style="{StaticResource Label}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Conversación" Style="{StaticResource CardTitle}" />
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox IsChecked="{Binding Realtime}" Style="{StaticResource Toggle}" />
                                            <StackPanel Style="{StaticResource Text}">
                                                <TextBlock Text="Voz en tiempo real" Style="{StaticResource Label}" />
                                                <TextBlock Text="Responde al instante, como una llamada. Apagado: escucha todo y luego responde (gasta menos)." Style="{StaticResource Sub}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Sep}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox IsChecked="{Binding Conversation}" Style="{StaticResource Toggle}" />
                                            <StackPanel Style="{StaticResource Text}">
                                                <TextBlock Text="Seguir escuchando después de responder" Style="{StaticResource Label}" />
                                                <TextBlock Text="Sin repetir «Oye Kroko». Termina si te callas o dices «gracias, eso es todo»." Style="{StaticResource Sub}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Sep}" />
                                        <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding Conversation}">
                                            <StackPanel Style="{StaticResource Right}" Orientation="Horizontal">
                                                <Slider Minimum="3" Maximum="20" Value="{Binding FollowUpSeconds}" Width="170" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FollowUpSeconds, StringFormat={}{0:0} s}" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Text}"><TextBlock Text="Cuánto espera a que sigas" Style="{StaticResource Label}" /></StackPanel>
                                        </DockPanel>
