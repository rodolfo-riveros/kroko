<Window x:Class="Kroko.App.Views.CommandPalette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Kroko.App.Views"
        Title="Kroko — Comandos"
        Width="620" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Foreground="{StaticResource Kroko.Text}"
        FontFamily="{StaticResource Kroko.Font}" FontSize="13">

    <Window.Resources>
        <v:BoolToVisibleConverter x:Key="BoolToVisible" />
        <v:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
        <!-- Tecla dibujada (Esc, Enter, Tab, Ctrl…) -->
        <Style x:Key="Key" TargetType="Border">
            <Setter Property="Background" Value="#1F1F22" />
            <Setter Property="BorderBrush" Value="#2E2E32" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Kroko.NavText}" />
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" Background="#0B0B0C" CornerRadius="18" BorderThickness="1" BorderBrush="#2A2A2E" Margin="16,0,16,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <!-- Buscar o pedir algo -->
            <DockPanel Margin="18,14,14,12">
                <Border DockPanel.Dock="Right" Style="{StaticResource Key}"><TextBlock Text="Esc" Style="{StaticResource KeyText}" /></Border>
                <v:KrokoMark DockPanel.Dock="Left" Width="30" Height="23" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Grid>
                    <TextBlock Text="Buscar o pedir algo" FontSize="17" Foreground="#5A5A60" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Query, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" />
                    <TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="17" Background="Transparent"
                             BorderThickness="0" Foreground="{StaticResource Kroko.Text}" CaretBrush="{StaticResource Kroko.Accent}"
                             VerticalAlignment="Center" PreviewKeyDown="QueryBox_PreviewKeyDown" />
                </Grid>
            </DockPanel>
            <Border Height="1" Background="#1F1F22" />

            <!-- Resultados -->
            <ItemsControl ItemsSource="{Binding Rows}" Margin="8,6,8,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock Text="{Binding Section}" FontSize="10.5" FontWeight="Bold" Foreground="#71717A" Margin="12,10,0,4"
                                       Visibility="{Binding IsHeader, Converter={StaticResource BoolToVisible}}" />
                            <Border x:Name="Row" CornerRadius="10" Padding="12,8" Cursor="Hand" Background="Transparent"
                                    Visibility="{Binding IsHeader, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}"
                                    MouseLeftButtonUp="Row_MouseLeftButtonUp">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Key}" Visibility="{Binding ShownHint, Converter={StaticResource EmptyToCollapsed}}">
                                        <TextBlock Text="{Binding ShownHint}" Style="{StaticResource KeyText}" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Kroko.TextMuted}"
                                               VerticalAlignment="Center" Margin="10,0" />
                                    <TextBlock x:Name="Icon" DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource Kroko.Icons}" FontSize="14"
                                               Width="20" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource Kroko.NavText}" />
                                    <TextBlock FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Before, Mode=OneWay}" /><Run Text="{Binding Match, Mode=OneWay}" FontWeight="Bold" /><Run Text="{Binding After, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#1A1D12" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Kroko.Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFile}" Value="True">
                                <Setter TargetName="Icon" Property="Foreground" Value="#5AB4FF" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Ayuda de teclas -->
            <Border Height="1" Background="#1F1F22" />
            <StackPanel Orientation="Horizontal" Margin="18,10,18,12">
                <Border Style="{StaticResource Key}"><TextBlock Text="↑↓" Style="{StaticResource KeyText}" /></Border>
                <TextBlock Text="moverse" FontSize="12" Foreground="{StaticResource Kroko.TextMuted}" Margin="6,0,16,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource Key}"><TextBlock Text="Enter" Style="{StaticResource KeyText}" /></Border>
                <TextBlock Text="ejecutar" FontSize="12" Foreground="{StaticResource Kroko.TextMuted}" Margin="6,0,16,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource Key}"><TextBlock Text="Tab" Style="{StaticResource KeyText}" /></Border>
                <TextBlock Text="preguntar" FontSize="12" Foreground="{StaticResource Kroko.TextMuted}" Margin="6,0,16,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource Key}"><TextBlock Text="Ctrl" Style="{StaticResource KeyText}" /></Border>
                <TextBlock Text="+" FontSize="12" Foreground="{StaticResource Kroko.TextMuted}" Margin="4,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource Key}"><TextBlock Text="Shift" Style="{StaticResource KeyText}" /></Border>
                <TextBlock Text="+" FontSize="12" Foreground="{StaticResource Kroko.TextMuted}" Margin="4,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource Key}"><TextBlock Text="Espacio" Style="{StaticResource KeyText}" /></Border>
                <TextBlock Text="abrir" FontSize="12" Foreground="{StaticResource Kroko.TextMuted}" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
