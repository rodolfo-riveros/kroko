<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Kroko.Shared\Kroko.Shared.csproj" />
  </ItemGroup>

  <!-- Solo en desarrollo: compilar la App también compila el cerebro local, para que nunca queden desfasados
       (la App de desarrollo lo arranca desde src/Kroko.Brain/bin). El instalador (Release) no lleva el cerebro. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\Kroko.Brain\Kroko.Brain.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="System.Speech" Version="10.0.14" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Vosk" Version="0.3.38" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Kroko.App</RootNamespace>
    <StartupObject>Kroko.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="Kroko.App.Tests" />
    <None Update="Face\expressions.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
